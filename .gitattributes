# pkg/ext-go/cgoengine/_csrc/plugin is a generated copy of lib/plugin (scripts/cgoengine-sync.sh);
# review the change in lib/plugin, not the copy. GitHub collapses these diffs.
pkg/ext-go/cgoengine/_csrc/plugin/** linguist-generated=true

# The fixtures under lib/plugin/testdata are read by every language's tests, and some
# are compared byte for byte with what the Go contract generates. They, and their
# copies under _csrc, keep LF on every platform, whatever core.autocrlf says.
lib/plugin/testdata/** text eol=lf
pkg/ext-go/cgoengine/_csrc/plugin/testdata/** text eol=lf
# The archive fixtures are binary: their SHA-256 is pinned in archive-cases.json.
lib/plugin/testdata/v1/archives/** binary
pkg/ext-go/cgoengine/_csrc/plugin/testdata/v1/archives/** binary

# Example plugins whose manifests pin their scripts by SHA-256 keep LF everywhere, so a Windows
# checkout hashes the same bytes.
pkg/ext-ruby/examples/** text eol=lf
