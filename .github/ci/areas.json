{
  "about": "CI areas: which reusable workflow runs which jobs, for which tools, on which platforms. ci.yml runs scripts/ci/plan.py over this table. main_paths: a push to main runs the area only if a changed file matches (null: always). pr_paths: a pull request without tool labels runs the area only if a changed file matches (null: always). Each job lists its matrix cells; a cell runs on the platform of its os (or the job's runs-on), unless the job names a platform. A job marked on_request is slow or needs a real device session: it runs only when a pull request or a manual run carries ci:full, never on a push to main.",
  "platforms": [
    "linux",
    "macos",
    "windows",
    "ios",
    "android"
  ],
  "tools": [
    "c",
    "csharp",
    "go",
    "java",
    "javascript",
    "lua",
    "php",
    "python",
    "ruby",
    "rust",
    "swift",
    "zig"
  ],
  "areas": {
    "native": {
      "workflow": ".github/workflows/native.yml",
      "tools": [
        "go",
        "swift",
        "csharp",
        "java"
      ],
      "main_paths": null,
      "pr_paths": null,
      "jobs": {
        "android-package": {
          "runs-on": "ubuntu-latest",
          "cells": [
            {
              "os": "ubuntu-latest"
            }
          ],
          "platform": "android"
        },
        "dist-branch": {
          "runs-on": "ubuntu-latest",
          "cells": [
            {
              "os": "ubuntu-latest"
            }
          ]
        },
        "ios-package": {
          "runs-on": "macos-latest",
          "cells": [
            {
              "os": "macos-latest"
            }
          ],
          "platform": "ios"
        },
        "linux-desktop": {
          "runs-on": "ubuntu-latest",
          "cells": [
            {
              "os": "ubuntu-latest"
            }
          ],
          "on_request": true
        },
        "native": {
          "runs-on": "${{ matrix.os }}",
          "cells": [
            {
              "os": "ubuntu-latest"
            },
            {
              "os": "macos-latest"
            },
            {
              "os": "windows-latest"
            }
          ]
        },
        "native-integration": {
          "runs-on": "${{ matrix.os }}",
          "cells": [
            {
              "os": "ubuntu-latest"
            },
            {
              "os": "macos-latest"
            }
          ]
        },
        "standalone-modules": {
          "runs-on": "ubuntu-latest",
          "cells": [
            {
              "os": "ubuntu-latest"
            }
          ]
        }
      }
    },
    "plugin-engine": {
      "workflow": ".github/workflows/plugin-engine.yml",
      "tools": [
        "c"
      ],
      "main_paths": [
        "lib/plugin/**",
        "pkg/ext-go/**",
        "scripts/plugin-engine-test.sh",
        ".github/workflows/plugin-engine.yml"
      ],
      "pr_paths": [
        "lib/plugin/**",
        "pkg/ext-go/**",
        "scripts/plugin-engine-test.sh",
        ".github/workflows/plugin-engine.yml"
      ],
      "jobs": {
        "fuzz": {
          "runs-on": "ubuntu-latest",
          "cells": [
            {
              "os": "ubuntu-latest"
            }
          ],
          "on_request": true
        },
        "posix": {
          "runs-on": "${{ matrix.os }}",
          "cells": [
            {
              "os": "ubuntu-latest"
            },
            {
              "os": "macos-latest"
            }
          ]
        },
        "windows": {
          "runs-on": "windows-latest",
          "cells": [
            {
              "os": "windows-latest"
            }
          ]
        },
        "windows-arm64": {
          "runs-on": "windows-11-arm",
          "cells": [
            {
              "os": "windows-11-arm"
            }
          ]
        },
        "windows-msvc": {
          "runs-on": "windows-latest",
          "cells": [
            {
              "os": "windows-latest"
            }
          ]
        }
      }
    },
    "c2goengine": {
      "workflow": ".github/workflows/c2goengine.yml",
      "tools": [
        "go",
        "c"
      ],
      "main_paths": [
        "lib/plugin/**",
        "pkg/ext-go/c2goengine/**",
        "pkg/ext-go/engine/plugintest/enginetest/**",
        ".github/workflows/c2goengine.yml"
      ],
      "pr_paths": [
        "lib/plugin/**",
        "pkg/ext-go/c2goengine/**",
        "pkg/ext-go/engine/plugintest/enginetest/**",
        ".github/workflows/c2goengine.yml"
      ],
      "jobs": {
        "tools": {
          "runs-on": "ubuntu-latest",
          "cells": [
            {
              "os": "ubuntu-latest"
            }
          ]
        },
        "translate": {
          "runs-on": "${{ matrix.os }}",
          "cells": [
            {
              "goarch": "amd64",
              "goos": "linux",
              "os": "ubuntu-latest",
              "race": "-race",
              "required": true
            },
            {
              "goarch": "arm64",
              "goos": "linux",
              "os": "ubuntu-24.04-arm",
              "race": "-race",
              "required": true
            },
            {
              "goarch": "arm64",
              "goos": "darwin",
              "os": "macos-latest",
              "race": "",
              "required": true
            },
            {
              "goarch": "amd64",
              "goos": "darwin",
              "os": "macos-15-intel",
              "race": "",
              "required": true
            },
            {
              "goarch": "amd64",
              "goos": "windows",
              "msystem": "MINGW64",
              "os": "windows-latest",
              "packages": "mingw-w64-x86_64-gcc",
              "race": "",
              "required": true
            },
            {
              "cc": "clang",
              "goarch": "arm64",
              "goos": "windows",
              "msystem": "CLANGARM64",
              "os": "windows-11-arm",
              "packages": "mingw-w64-clang-aarch64-clang",
              "race": "",
              "required": true
            }
          ]
        }
      }
    },
    "host-cases": {
      "workflow": ".github/workflows/host-cases.yml",
