      "jobs": {
        "go-purego": {
          "runs-on": "${{ matrix.os }}",
          "cells": [
            {
              "os": "ubuntu-latest"
            },
            {
              "os": "ubuntu-24.04-arm"
            },
            {
              "os": "macos-15"
            },
            {
              "os": "macos-15-intel"
            },
            {
              "os": "windows-latest"
            },
            {
              "os": "windows-11-arm"
            }
          ]
        },
        "hosts": {
          "runs-on": "${{ matrix.os }}",
          "cells": [
            {
              "lua": "5.1.5",
              "os": "ubuntu-22.04",
              "php": "8.1",
              "python": "3.8",
              "ruby": "3.1"
            },
            {
              "lua": "5.4.9",
              "os": "ubuntu-latest",
              "php": "8.4",
              "python": "3.13",
              "ruby": "3.4"
            },
            {
              "lua": "luajit-2.1",
              "os": "ubuntu-24.04-arm",
              "php": "8.4",
              "python": "3.13",
              "ruby": "4.0"
            },
            {
              "lua": "5.5.1",
              "os": "macos-15",
              "php": "8.4",
              "python": "3.13",
              "ruby": "3.4"
            }
          ]
        },
        "windows": {
          "runs-on": "windows-latest",
          "cells": [
            {
              "toolchain": "mingw"
            },
            {
              "toolchain": "msvc"
            }
          ]
        }
      }
