{
  "about": "Release packages. release.yml routes a tag to the package whose prefix it starts with (the longest prefix wins), a manual run to the package named, and a pull request to the packages whose pr_paths match a changed file (null: never on pull requests). A package's build cells run its scripts/release/<package>/build.sh (one per platform where it has several) and upload release-out/; the publish job downloads them into dist/, runs prepare.sh, attests dist/*, and runs release.sh; registry names the one registry job that publishes it next (crates, npm, pypi, nuget), and distribute runs distribute.sh to push its dist/ branch. Only a tag push of a package's own prefix publishes; every other run is a dry run of its build cells.",
  "packages": {
    "ext-android": {
      "tag_prefixes": [
        "ext-android-v"
      ],
      "pr_paths": null,
      "version_default": "0.0.0",
      "publishes": "Android SDK (GitHub release)",
      "build": [
        {
          "name": "ext-android build (ubuntu-latest)",
          "runner": "ubuntu-latest",
          "script": "scripts/release/ext-android/build.sh",
          "vars": {},
          "setup": {
            "java": "17",
            "rust": "1.98.1",
            "rust_targets": "wasm32-wasip1",
            "rust_components": "",
            "gradle": "8.14.3"
          },
          "artifact": "release-ext-android-ubuntu-latest",
          "timeout": 60,
          "android_emulator": "scripts/release/ext-android/emulator.sh",
          "wamr_cache": true
        }
      ],
      "publish_setup": {},
      "registry": null,
      "distribute": false
    },
