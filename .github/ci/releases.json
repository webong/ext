{
  "about": "Package release configurations. Each package's workflow (Core by default) owns the dry run requested by its release:<package> label. The publisher routes pushed or manually selected tags by their longest matching prefix and uses the package's build, publish, registry, and distribution settings.",
  "packages": {
    "ext-android": {
      "tag_prefixes": [
        "ext-android-v"
      ],
      "workflow": "runtime",
      "version_default": "0.0.0",
      "publishes": "Android SDK (GitHub release)",
      "build": [
        {
          "name": "ext-android build (ubuntu-latest)",
          "runner": "ubuntu-latest",
          "script": "scripts/release/ext-android/build.sh",
          "vars": {},
          "setup": {
            "java": "17",
            "rust": "1.98.1",
            "rust_targets": "wasm32-wasip1",
            "rust_components": "",
            "gradle": "8.14.3"
          },
          "artifact": "release-ext-android-ubuntu-latest",
          "timeout": 60,
          "android_emulator": "scripts/release/ext-android/emulator.sh",
          "wamr_cache": true
        }
      ],
      "publish_setup": {},
      "registry": null,
      "distribute": false
    },
