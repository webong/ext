#!/usr/bin/env sh
set -eu

container=${EXT_ADAPTER_REAL_COMMAND:-}
[ -n "$container" ] && [ -x "$container" ] || { printf 'apple: container CLI is not installed\n' >&2; exit 127; }
operation=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
selection=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
if [ "${1:-}" = -- ]; then shift; fi
volume_image=${EXT_VOLUME_IMAGE:-alpine:3.21}

available() { "$container" system version >/dev/null 2>&1; }
valid_selection() { [ "$1" = local ] && available; }
safe_image_load() {
  version=$("$container" --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
  [ -n "$version" ] || return 1
  awk -F. -v version="$version" 'BEGIN { split(version, p, "."); exit !(p[1] > 1 || (p[1] == 1 && (p[2] > 3 || (p[2] == 3 && p[3] > 0)))) }'
}

case "$operation" in
  list) available && printf 'local\n' ;;
  validate) valid_selection "$selection" || { printf 'apple: local container runtime is unavailable\n' >&2; exit 1; } ;;
  doctor) if [ -n "$selection" ]; then valid_selection "$selection"; else available; fi ;;
  run) [ -z "$selection" ] || [ "$selection" = local ] || exit 1; exec "$container" "$@" ;;
  image_save) archive=$1; shift; exec "$container" image save --output "$archive" "$@" ;;
  image_load)
    safe_image_load || { printf 'apple: image import requires container newer than 1.3.0\n' >&2; exit 1; }
    exec "$container" image load --input "$1"
    ;;
  volume_exists) "$container" volume inspect "$1" >/dev/null 2>&1 ;;
  volume_create) exec "$container" volume create "$1" ;;
  volume_export) exec "$container" run --rm -v "$1:/volume:ro" "$volume_image" tar -C /volume -cf - . ;;
  volume_import) exec "$container" run --rm -i -v "$1:/volume" "$volume_image" tar -C /volume -xf - ;;
  *) exit 2 ;;
esac
