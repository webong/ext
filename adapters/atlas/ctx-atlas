#!/usr/bin/env sh
set -eu
platform=${CTX_PLATFORM:-$(uname -s)}
profiles_root() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/com.openai.atlas.web" ;;
    Linux) [ -n '' ] || return 1; printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/" ;;
    *) return 1 ;;
  esac
}
profile_exists() {
  case "$1" in
    /*) [ -f "$1/Preferences" ] || [ -f "$1" ] ;;
    *) root=$(profiles_root) || return 1
       if [ "$1" = root ]; then [ -f "$root/Preferences" ]; else [ -f "$root/$1/Preferences" ]; fi ;;
  esac
}
list_profiles() {
  root=$(profiles_root) || return 0
  [ -d "$root" ] || return 0
  if [ -f "$root/Preferences" ]; then printf 'atlas:root\n'; fi
  for preferences in "$root/Default/Preferences" "$root"/Profile\ */Preferences; do
    [ -f "$preferences" ] || continue
    directory=${preferences%/Preferences}; directory=${directory##*/}
    printf 'atlas:%s\n' "$directory"
  done
}
operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
        exec "$(dirname "$0")/ctx-atlas-share" "$@" ;;
  list) list_profiles ;;
  validate) profile_exists "$selection" ;;
  doctor) if [ -z "$selection" ]; then profiles_root >/dev/null; else profile_exists "$selection"; fi ;;
  *) exit 2 ;;
esac
