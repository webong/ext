#!/usr/bin/env sh
set -eu

platform=${CTX_PLATFORM:-$(uname -s)}

find_brave() {
  case "$platform" in
    Darwin)
      opener=$(command -v open 2>/dev/null || true)
      [ -n "$opener" ] || return 1
      if "$opener" -Ra 'Brave Browser' >/dev/null 2>&1; then BRAVE_APP='Brave Browser'; return 0; fi
      for candidate in "$HOME/Applications/Brave Browser.app" '/Applications/Brave Browser.app'; do
        if [ -d "$candidate" ] && "$opener" -Ra "$candidate" >/dev/null 2>&1; then BRAVE_APP=$candidate; return 0; fi
      done
      return 1
      ;;
    *) BRAVE_BIN=$(command -v brave-browser 2>/dev/null || command -v brave 2>/dev/null || true); [ -n "$BRAVE_BIN" ] ;;
  esac
}

profiles_root() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/BraveSoftware/Brave-Browser" ;;
    *) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/BraveSoftware/Brave-Browser" ;;
  esac
}

list_profiles() {
  root=$(profiles_root)
  [ -d "$root" ] || return 0
  for preferences in "$root/Default/Preferences" "$root"/Profile\ */Preferences; do
    [ -f "$preferences" ] || continue
    directory=${preferences%/Preferences}; directory=${directory##*/}
    printf 'brave:%s\n' "$directory"
  done
}

profile_exists() { root=$(profiles_root); [ -f "$root/$1/Preferences" ]; }

operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
    helper=$(dirname "$0")/ctx-brave-share
    exec "$helper" "$@"
    ;;
  list) find_brave || exit 0; list_profiles ;;
  validate) find_brave && profile_exists "$selection" ;;
  doctor) find_brave; [ -z "$selection" ] || profile_exists "$selection" ;;
  open)
    find_brave && profile_exists "$selection" || { printf 'brave: profile %s is unavailable\n' "$selection" >&2; exit 1; }
    shift 2; [ "${1:-}" = -- ] && shift
    case "$platform" in
      Darwin) exec "$opener" -na "$BRAVE_APP" --args "--profile-directory=$selection" "$@" ;;
      *) exec "$BRAVE_BIN" "--profile-directory=$selection" "$@" ;;
    esac
    ;;
  *) exit 2 ;;
esac
