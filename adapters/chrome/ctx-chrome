#!/usr/bin/env sh
set -eu

platform=${CTX_PLATFORM:-$(uname -s)}

find_chrome() {
  case "$platform" in
    Darwin)
      opener=$(command -v open 2>/dev/null || true)
      [ -n "$opener" ] || return 1
      if "$opener" -Ra 'Google Chrome' >/dev/null 2>&1; then CHROME_APP='Google Chrome'; return 0; fi
      for candidate in "$HOME/Applications/Google Chrome.app" "$HOME/Applications/Chrome.app" '/Applications/Google Chrome.app' /Applications/Chrome.app; do
        if [ -d "$candidate" ] && "$opener" -Ra "$candidate" >/dev/null 2>&1; then CHROME_APP=$candidate; return 0; fi
      done
      return 1
      ;;
    *) CHROME_BIN=$(command -v google-chrome 2>/dev/null || command -v google-chrome-stable 2>/dev/null || true); [ -n "$CHROME_BIN" ] ;;
  esac
}

profiles_root() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/Google/Chrome" ;;
    *) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/google-chrome" ;;
  esac
}

list_profiles() {
  root=$(profiles_root)
  [ -d "$root" ] || return 0
  for preferences in "$root/Default/Preferences" "$root"/Profile\ */Preferences; do
    [ -f "$preferences" ] || continue
    directory=${preferences%/Preferences}; directory=${directory##*/}
    printf 'chrome:%s\n' "$directory"
  done
}

profile_exists() { root=$(profiles_root); [ -f "$root/$1/Preferences" ]; }

operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
    helper=$(dirname "$0")/ctx-chrome-share
    exec "$helper" "$@"
    ;;
  list) find_chrome || exit 0; list_profiles ;;
  validate) find_chrome && profile_exists "$selection" ;;
  doctor) find_chrome; [ -z "$selection" ] || profile_exists "$selection" ;;
  open)
    find_chrome && profile_exists "$selection" || { printf 'chrome: profile %s is unavailable\n' "$selection" >&2; exit 1; }
    shift 2; [ "${1:-}" = -- ] && shift
    case "$platform" in
      Darwin) exec "$opener" -na "$CHROME_APP" --args "--profile-directory=$selection" "$@" ;;
      *) exec "$CHROME_BIN" "--profile-directory=$selection" "$@" ;;
    esac
    ;;
  *) exit 2 ;;
esac
