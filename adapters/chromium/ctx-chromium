#!/usr/bin/env sh
set -eu

platform=${CTX_PLATFORM:-$(uname -s)}

find_chromium() {
  case "$platform" in
    Darwin)
      opener=$(command -v open 2>/dev/null || true)
      [ -n "$opener" ] || return 1
      if "$opener" -Ra Chromium >/dev/null 2>&1; then CHROMIUM_APP=Chromium; return 0; fi
      for candidate in "$HOME/Applications/Chromium.app" /Applications/Chromium.app; do
        if [ -d "$candidate" ] && "$opener" -Ra "$candidate" >/dev/null 2>&1; then CHROMIUM_APP=$candidate; return 0; fi
      done
      return 1
      ;;
    *) CHROMIUM_BIN=$(command -v chromium 2>/dev/null || command -v chromium-browser 2>/dev/null || true); [ -n "$CHROMIUM_BIN" ] ;;
  esac
}

profiles_root() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/Chromium" ;;
    *) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/chromium" ;;
  esac
}

list_profiles() {
  root=$(profiles_root)
  [ -d "$root" ] || return 0
  for preferences in "$root/Default/Preferences" "$root"/Profile\ */Preferences; do
    [ -f "$preferences" ] || continue
    directory=${preferences%/Preferences}; directory=${directory##*/}
    printf 'chromium:%s\n' "$directory"
  done
}

profile_exists() { root=$(profiles_root); [ -f "$root/$1/Preferences" ]; }

operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
    helper=$(dirname "$0")/ctx-chromium-share
    exec "$helper" "$@"
    ;;
  list) find_chromium || exit 0; list_profiles ;;
  validate) find_chromium && profile_exists "$selection" ;;
  doctor) find_chromium; [ -z "$selection" ] || profile_exists "$selection" ;;
  open)
    find_chromium && profile_exists "$selection" || { printf 'chromium: profile %s is unavailable\n' "$selection" >&2; exit 1; }
    shift 2; [ "${1:-}" = -- ] && shift
    case "$platform" in
      Darwin) exec "$opener" -na "$CHROMIUM_APP" --args "--profile-directory=$selection" "$@" ;;
      *) exec "$CHROMIUM_BIN" "--profile-directory=$selection" "$@" ;;
    esac
    ;;
  *) exit 2 ;;
esac
