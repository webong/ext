#!/usr/bin/env sh
set -eu

claude=${EXT_ADAPTER_REAL_COMMAND:-}
operation=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
if [ "${1:-}" = -- ]; then shift; fi

case "$operation" in
  validate) [ -n "$claude" ] || { printf 'claude: Claude Code CLI is not installed\n' >&2; exit 127; } ;;
  doctor)
    [ -n "$claude" ] || { printf 'claude: Claude Code CLI is not installed\n' >&2; exit 127; }
    "$claude" --version >/dev/null
    ;;
  run)
    [ -n "$claude" ] || { printf 'claude: Claude Code CLI is not installed\n' >&2; exit 127; }
    exec "$claude" "$@"
    ;;
  hook)
    event=${1:-}
    [ -n "$event" ] || { printf 'claude: hook needs an event name\n' >&2; exit 2; }
    handler=${EXT_ADAPTER_VALUE_COMPUTER_HOOK_COMMAND:-${EXT_COMPUTER_HOOK_COMMAND:-}}
    [ -n "$handler" ] || { printf 'claude: set EXT_COMPUTER_HOOK_COMMAND to a hook handler executable\n' >&2; exit 127; }
    exec "$handler" "$event"
    ;;
  plugin)
    [ -n "$claude" ] || { printf 'claude: Claude Code CLI is not installed\n' >&2; exit 127; }
    exec "$claude" plugin "$@"
    ;;
  *) exit 2 ;;
esac
