{
  "apiVersion": "ext.io/v1",
  "artifacts": [
    {
      "name": "main",
      "path": "ctx-comet",
      "sha256": ""
    },
    {
      "name": "main-windows",
      "path": "ctx-comet.ps1",
      "sha256": ""
    }
  ],
  "entrypoints": [
    {
      "name": "main",
      "runtime": "argv",
      "artifact": "main",
      "protocols": [
        "ext.adapter/2.0"
      ]
    },
    {
      "name": "main.windows",
      "runtime": "argv",
      "artifact": "main-windows",
      "protocols": [
        "ext.adapter/2.0"
      ]
    }
  ],
  "metadata": {
    "ctx.adapter/v1": {
      "browser_query_priority": 110,
      "description": "Comet browser provider",
      "display_name": "Comet",
      "runtime": "browser",
      "selector_key": "browser",
      "share_spaces": [
        "browser"
      ],
      "surfaces": [
        "web"
      ],
      "share_dependencies": [
        "credential:keychain",
        "credential:secret_service"
      ]
    }
  },
  "requires": [
    {
      "provider": "keychain",
      "contract": {
        "name": "ext.adapter",
        "version": "2.0"
      },
      "operation": "share",
      "os": "darwin"
    },
    {
      "provider": "secret_service",
      "contract": {
        "name": "ext.adapter",
        "version": "2.0"
      },
      "operation": "share",
      "os": "linux"
    }
  ],
  "kind": "package",
  "identity": {
    "id": "comet",
    "revision": ""
  },
  "contracts": [
    {
      "name": "ext.adapter",
      "version": "2.0",
      "operations": [
        {
          "name": "list"
        },
        {
          "name": "validate"
        },
        {
          "name": "doctor"
        },
        {
          "name": "share"
        }
      ]
    },
    {
      "name": "ext.adapter.browser.share",
      "version": "1",
      "operations": [
        {
          "name": "cookie.list"
        },
        {
          "name": "cookie.export"
        },
        {
          "name": "cookie.query"
        },
        {
          "name": "cookie.normalize"
        },
        {
          "name": "cookie.import"
        }
      ]
    },
    {
      "name": "ext.adapter.browser.management",
      "version": "1",
      "operations": [
        {
          "name": "extension.targets"
        },
        {
          "name": "extension.capabilities"
        },
        {
          "name": "extension.prepare"
        },
        {
          "name": "extension.package"
        },
        {
          "name": "extension.sign"
        },
        {
          "name": "extension.update_manifest"
        },
        {
          "name": "extension.stage"
        },
        {
          "name": "userscript.prepare"
        },
        {
          "name": "userscript.install"
        },
        {
          "name": "userscript.update"
        },
        {
          "name": "userscript.list"
        },
        {
          "name": "userscript.describe"
        },
        {
          "name": "userscript.enable"
        },
        {
          "name": "userscript.disable"
        },
        {
          "name": "userscript.uninstall"
        },
        {
          "name": "bookmarklet.encode"
        },
        {
          "name": "bookmarklet.decode"
        },
        {
          "name": "bookmarklet.install_page"
        }
      ]
    }
  ]
}
