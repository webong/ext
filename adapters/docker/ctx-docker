#!/usr/bin/env sh
set -eu

docker=${EXT_ADAPTER_REAL_COMMAND:-}
[ -n "$docker" ] && [ -x "$docker" ] || { printf 'docker: Docker CLI is not installed\n' >&2; exit 127; }
operation=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
selection=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
if [ "${1:-}" = -- ]; then shift; fi
volume_image=${EXT_VOLUME_IMAGE:-alpine:3.21}

has_run_override() {
  if [ -n "${DOCKER_CONTEXT:-}" ] || [ -n "${DOCKER_HOST:-}" ] || [ "${1:-}" = context ]; then return 0; fi
  for argument in "$@"; do case "$argument" in --context|--context=*|--host|--host=*|-H|-H?*) return 0;; esac; done
  return 1
}

case "$operation" in
  list) "$docker" context ls --format '{{.Name}}' ;;
  observe)
    names=$("$docker" context ls --format '{{json .Name}}') || exit $?
    printf '{"version":1,"contexts":['
    separator=''
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      printf '%s{"selection":%s}' "$separator" "$name"
      separator=,
    done <<EOF
$names
EOF
    printf ']}\n'
    ;;
  validate) "$docker" context inspect "$selection" >/dev/null 2>&1 || { printf 'docker: unknown context %s\n' "$selection" >&2; exit 1; } ;;
  doctor)
    if [ -n "$selection" ]; then "$docker" context inspect "$selection" >/dev/null 2>&1
    else "$docker" version >/dev/null 2>&1
    fi
    ;;
  run) if [ -z "$selection" ] || has_run_override "$@"; then exec "$docker" "$@"; else exec "$docker" --context "$selection" "$@"; fi ;;
  build)
    [ "${1:-}" = --cache-ref ] && [ "$#" -ge 2 ] || exit 2
    cache_ref=$2; shift 2; [ "${1:-}" = -- ] && shift
    if [ -n "$selection" ]; then set -- --context "$selection" buildx build --cache-from "type=registry,ref=$cache_ref" --cache-to "type=registry,ref=$cache_ref,mode=max" "$@"
    else set -- buildx build --cache-from "type=registry,ref=$cache_ref" --cache-to "type=registry,ref=$cache_ref,mode=max" "$@"
    fi
    exec "$docker" "$@"
    ;;
  image_push) exec "$docker" --context "$selection" image push "$@" ;;
  image_pull) exec "$docker" --context "$selection" image pull "$@" ;;
  image_save) archive=$1; shift; exec "$docker" --context "$selection" image save -o "$archive" "$@" ;;
  image_load) exec "$docker" --context "$selection" image load -i "$1" ;;
  volume_exists) "$docker" --context "$selection" volume inspect "$1" >/dev/null 2>&1 ;;
  volume_create) exec "$docker" --context "$selection" volume create "$1" ;;
  volume_export) exec "$docker" --context "$selection" run --rm -v "$1:/volume:ro" "$volume_image" tar -C /volume -cf - . ;;
  volume_import) exec "$docker" --context "$selection" run --rm -i -v "$1:/volume" "$volume_image" tar -C /volume -xf - ;;
  *) exit 2 ;;
esac
