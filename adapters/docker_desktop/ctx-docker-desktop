#!/usr/bin/env sh
set -eu

operation=${1:-}
[ "$#" -eq 0 ] || shift
selection=${1:-}
[ "$#" -eq 0 ] || shift
[ "${1:-}" != -- ] || shift

docker=${EXT_DOCKER_DESKTOP_CLI:-}
if [ -z "$docker" ] && [ -x /Applications/Docker.app/Contents/Resources/bin/docker ]; then
  docker=/Applications/Docker.app/Contents/Resources/bin/docker
fi
if [ -z "$docker" ] && [ -n "${EXT_EXECUTABLE:-}" ]; then
  docker=$("$EXT_EXECUTABLE" real docker 2>/dev/null || :)
fi
if [ -z "$docker" ] && [ -z "${EXT_EXECUTABLE:-}" ]; then docker=$(command -v docker 2>/dev/null || :); fi
desktop_available() { [ -n "$docker" ] && "$docker" desktop version >/dev/null 2>&1; }

case "$operation" in
  list) desktop_available && printf 'local\n' ;;
  validate) [ "$selection" = local ] && desktop_available || { printf 'docker_desktop: Docker Desktop CLI is unavailable\n' >&2; exit 1; } ;;
  run)
    desktop_available || { printf 'docker_desktop: Docker Desktop CLI is unavailable\n' >&2; exit 127; }
    case "${1:-}" in
      status)
        if status=$("$docker" desktop status 2>&1); then printf '%s\n' "$status"
        elif printf '%s\n' "$status" | grep -Fq 'Is Docker Desktop running?'; then printf 'Stopped\n'
        else printf '%s\n' "$status" >&2; exit 1
        fi
        ;;
      start|stop) exec "$docker" desktop "$1" ;;
      *) printf 'docker_desktop: expected status, start, or stop\n' >&2; exit 2 ;;
    esac
    ;;
  doctor)
    if ! desktop_available; then printf 'skip Docker Desktop CLI is not installed\n'; exit 0; fi
    if status=$("$docker" desktop status 2>&1); then
      printf 'ok   Docker Desktop status: %s\n' "$status"
    elif printf '%s\n' "$status" | grep -Fq 'Is Docker Desktop running?'; then
      printf 'ok   Docker Desktop is stopped\n'
    else
      printf 'fail Docker Desktop status: %s\n' "$status"
      exit 1
    fi
    ;;
  *) exit 2 ;;
esac
