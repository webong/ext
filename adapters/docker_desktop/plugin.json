{
  "apiVersion": "ext.package/v1",
  "descriptor": {
    "apiVersion": "ext.plugin/v1",
    "identity": {
      "id": "docker_desktop",
      "revision": ""
    },
    "contracts": [
      {
        "name": "ext.adapter",
        "version": "2.0",
        "operations": [
          {
            "name": "list"
          },
          {
            "name": "validate"
          },
          {
            "name": "run"
          },
          {
            "name": "doctor"
          }
        ]
      }
    ]
  },
  "artifacts": [
    {
      "name": "main",
      "path": "ctx-docker-desktop",
      "sha256": ""
    },
    {
      "name": "main-windows",
      "path": "ctx-docker-desktop.ps1",
      "sha256": ""
    }
  ],
  "entrypoints": [
    {
      "name": "main",
      "runtime": "argv",
      "artifact": "main",
      "protocols": [
        "ext.adapter/2.0"
      ]
    },
    {
      "name": "main.windows",
      "runtime": "argv",
      "artifact": "main-windows",
      "protocols": [
        "ext.adapter/2.0"
      ]
    }
  ],
  "metadata": {
    "ctx.adapter/v1": {
      "description": "Docker Desktop lifecycle and status diagnostics",
      "runtime": "manager",
      "selector_key": "docker_desktop",
      "self_contained": true,
      "supports": [
        "engine",
        "emulator",
        "executor",
        "container"
      ],
      "surfaces": [
        "shell"
      ]
    }
  }
}
