#!/usr/bin/env sh
set -eu

platform=${CTX_PLATFORM:-$(uname -s)}

find_edge() {
  case "$platform" in
    Darwin)
      opener=$(command -v open 2>/dev/null || true)
      [ -n "$opener" ] || return 1
      if "$opener" -Ra 'Microsoft Edge' >/dev/null 2>&1; then EDGE_APP='Microsoft Edge'; return 0; fi
      for candidate in "$HOME/Applications/Microsoft Edge.app" '/Applications/Microsoft Edge.app'; do
        if [ -d "$candidate" ] && "$opener" -Ra "$candidate" >/dev/null 2>&1; then EDGE_APP=$candidate; return 0; fi
      done
      return 1
      ;;
    *) EDGE_BIN=$(command -v microsoft-edge 2>/dev/null || command -v microsoft-edge-stable 2>/dev/null || true); [ -n "$EDGE_BIN" ] ;;
  esac
}

profiles_root() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/Microsoft Edge" ;;
    *) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/microsoft-edge" ;;
  esac
}

list_profiles() {
  root=$(profiles_root)
  [ -d "$root" ] || return 0
  for preferences in "$root/Default/Preferences" "$root"/Profile\ */Preferences; do
    [ -f "$preferences" ] || continue
    directory=${preferences%/Preferences}; directory=${directory##*/}
    printf 'edge:%s\n' "$directory"
  done
}

profile_exists() { root=$(profiles_root); [ -f "$root/$1/Preferences" ]; }

operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
    helper=$(dirname "$0")/ctx-edge-share
    exec "$helper" "$@"
    ;;
  list) find_edge || exit 0; list_profiles ;;
  validate) find_edge && profile_exists "$selection" ;;
  doctor) find_edge; [ -z "$selection" ] || profile_exists "$selection" ;;
  open)
    find_edge && profile_exists "$selection" || { printf 'edge: profile %s is unavailable\n' "$selection" >&2; exit 1; }
    shift 2; [ "${1:-}" = -- ] && shift
    case "$platform" in
      Darwin) exec "$opener" -na "$EDGE_APP" --args "--profile-directory=$selection" "$@" ;;
      *) exec "$EDGE_BIN" "--profile-directory=$selection" "$@" ;;
    esac
    ;;
  *) exit 2 ;;
esac
