#!/usr/bin/env sh
set -eu

platform=${CTX_PLATFORM:-$(uname -s)}

find_firefox() {
  case "$platform" in
    Darwin)
      opener=$(command -v open 2>/dev/null || true)
      [ -n "$opener" ] || return 1
      if "$opener" -Ra Firefox >/dev/null 2>&1; then FIREFOX_APP=Firefox; return 0; fi
      for candidate in "$HOME/Applications/Firefox.app" /Applications/Firefox.app; do
        if [ -d "$candidate" ] && "$opener" -Ra "$candidate" >/dev/null 2>&1; then FIREFOX_APP=$candidate; return 0; fi
      done
      return 1
      ;;
    *) FIREFOX_BIN=$(command -v firefox 2>/dev/null || true); [ -n "$FIREFOX_BIN" ] ;;
  esac
}

profiles_file() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/Firefox/profiles.ini" ;;
    *)
      standard="$HOME/.mozilla/firefox/profiles.ini"
      snap="$HOME/snap/firefox/common/.mozilla/firefox/profiles.ini"
      if [ -f "$standard" ]; then printf '%s\n' "$standard"; else printf '%s\n' "$snap"; fi
      ;;
  esac
}

list_profiles() {
  file=$(profiles_file)
  [ -f "$file" ] || return 0
  awk '
    /^\[Profile[0-9]+\]$/ { in_profile=1; next }
    /^\[/ { in_profile=0 }
    in_profile && /^Name=/ {
      name=$0; sub(/^Name=/, "", name)
      if (name != "") print "firefox:" name
    }
  ' "$file"
}

profile_exists() {
  requested=$1
  file=$(profiles_file)
  [ -f "$file" ] || return 1
  awk -v requested="$requested" '
    /^\[Profile[0-9]+\]$/ { in_profile=1; next }
    /^\[/ { in_profile=0 }
    in_profile && /^Name=/ { name=$0; sub(/^Name=/, "", name); if (name == requested) found=1 }
    END { exit !found }
  ' "$file"
}

operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
    helper=$(dirname "$0")/ctx-firefox-share
    exec "$helper" "$@"
    ;;
  list) find_firefox || exit 0; list_profiles ;;
  validate) find_firefox && profile_exists "$selection" ;;
  doctor) find_firefox; [ -z "$selection" ] || profile_exists "$selection" ;;
  open)
    find_firefox && profile_exists "$selection" || { printf 'firefox: profile %s is unavailable\n' "$selection" >&2; exit 1; }
    shift 2; [ "${1:-}" = -- ] && shift
    case "$platform" in
      Darwin) exec "$opener" -na "$FIREFOX_APP" --args -P "$selection" "$@" ;;
      *) exec "$FIREFOX_BIN" -P "$selection" "$@" ;;
    esac
    ;;
  *) exit 2 ;;
esac
