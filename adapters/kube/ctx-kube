#!/usr/bin/env sh
set -eu

kubectl=$(command -v kubectl 2>/dev/null || true)
[ -n "$kubectl" ] || { printf 'kube: kubectl is not installed\n' >&2; exit 127; }

has_context() { for arg in "$@"; do case "$arg" in --context|--context=*) return 0;; esac; done; return 1; }
has_namespace() { for arg in "$@"; do case "$arg" in --namespace|--namespace=*|-n|-n?*) return 0;; esac; done; return 1; }
validate_context() {
  context=$1
  config=${2:-}
  if [ -n "$config" ]; then KUBECONFIG="$config" "$kubectl" config get-contexts "$context" >/dev/null 2>&1
  else "$kubectl" config get-contexts "$context" >/dev/null 2>&1
  fi
}

operation=${1:-}
selection=${2:-}
case "$operation" in
  list) "$kubectl" config get-contexts ;;
  configure)
    shift 2
    [ "${1:-}" = -- ] && shift
    namespace=
    kubeconfig=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --namespace) [ "$#" -ge 2 ] || exit 2; namespace=$2; shift 2 ;;
        --namespace=*) namespace=${1#--namespace=}; shift ;;
        --kubeconfig) [ "$#" -ge 2 ] || exit 2; kubeconfig=$2; shift 2 ;;
        --kubeconfig=*) kubeconfig=${1#--kubeconfig=}; shift ;;
        *) printf 'kube: unsupported selection option %s\n' "$1" >&2; exit 2 ;;
      esac
    done
    validate_context "$selection" "$kubeconfig" || { printf 'kube: unknown context %s\n' "$selection" >&2; exit 1; }
    printf 'kube_context\t%s\n' "$selection"
    if [ -n "$namespace" ]; then printf 'kube_namespace\t%s\n' "$namespace"; fi
    if [ -n "$kubeconfig" ]; then printf 'kubeconfig\t%s\n' "$kubeconfig"; fi
    ;;
  validate)
    validate_context "$selection" "${EXT_ADAPTER_VALUE_KUBECONFIG:-}" || { printf 'kube: unknown context %s\n' "$selection" >&2; exit 1; }
    ;;
  doctor)
    [ -z "$selection" ] || validate_context "$selection" "${EXT_ADAPTER_VALUE_KUBECONFIG:-}" || { printf 'kube: unknown context %s\n' "$selection" >&2; exit 1; }
    ;;
  run)
    shift 2
    [ "${1:-}" = -- ] && shift
    context=${EXT_ADAPTER_VALUE_KUBE_CONTEXT:-$selection}
    namespace=${EXT_ADAPTER_VALUE_KUBE_NAMESPACE:-}
    kubeconfig=${EXT_ADAPTER_VALUE_KUBECONFIG:-}
    if [ -n "$namespace" ] && ! has_namespace "$@"; then set -- --namespace "$namespace" "$@"; fi
    if [ -n "$context" ] && ! has_context "$@"; then set -- --context "$context" "$@"; fi
    if [ -n "$kubeconfig" ] && [ -z "${KUBECONFIG:-}" ]; then KUBECONFIG="$kubeconfig" "$kubectl" "$@"
    else "$kubectl" "$@"
    fi
    ;;
  *) exit 2 ;;
esac
