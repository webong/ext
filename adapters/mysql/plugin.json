{
  "apiVersion": "ext.package/v1",
  "descriptor": {
    "apiVersion": "ext.plugin/v1",
    "identity": {
      "id": "mysql",
      "revision": ""
    },
    "contracts": [
      {
        "name": "ext.adapter",
        "version": "2.0",
        "operations": [
          {
            "name": "validate"
          },
          {
            "name": "run"
          },
          {
            "name": "doctor"
          }
        ]
      }
    ]
  },
  "artifacts": [
    {
      "name": "main",
      "path": "ctx-mysql",
      "sha256": ""
    },
    {
      "name": "main-windows",
      "path": "ctx-mysql.ps1",
      "sha256": ""
    }
  ],
  "entrypoints": [
