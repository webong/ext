#!/usr/bin/env sh
set -eu

nerdctl=${EXT_ADAPTER_REAL_COMMAND:-}
[ -n "$nerdctl" ] && [ -x "$nerdctl" ] || { printf 'nerdctl: nerdctl is not installed\n' >&2; exit 127; }
operation=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
selection=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
if [ "${1:-}" = -- ]; then shift; fi
volume_image=${EXT_VOLUME_IMAGE:-alpine:3.21}
address=${EXT_MANAGER_ADDRESS:-}

run_nerdctl() {
  if [ -n "$address" ]; then "$nerdctl" --address "$address" "$@"
  else "$nerdctl" "$@"
  fi
}
exec_nerdctl() {
  if [ -n "$address" ]; then exec "$nerdctl" --address "$address" "$@"
  else exec "$nerdctl" "$@"
  fi
}
namespaces() { run_nerdctl namespace ls --quiet; }
has_namespace() { namespaces | grep -Fxq "$1"; }
has_run_override() {
  if [ -n "${CONTAINERD_NAMESPACE:-}" ] || [ -n "${CONTAINERD_ADDRESS:-}" ] || [ "${1:-}" = namespace ]; then return 0; fi
  for argument in "$@"; do case "$argument" in --namespace|--namespace=*|--address|--address=*|-n|-n?*|-a|-a?*) return 0;; esac; done
  return 1
}

case "$operation" in
  list) namespaces ;;
  validate) has_namespace "$selection" || { printf 'nerdctl: unknown namespace %s\n' "$selection" >&2; exit 1; } ;;
  doctor) if [ -n "$selection" ]; then has_namespace "$selection"; else "$nerdctl" version >/dev/null 2>&1; fi ;;
  run) if [ -z "$selection" ] || has_run_override "$@"; then exec "$nerdctl" "$@"; else exec "$nerdctl" --namespace "$selection" "$@"; fi ;;
  build)
    [ "${1:-}" = --cache-ref ] && [ "$#" -ge 2 ] || exit 2
    cache_ref=$2; shift 2; [ "${1:-}" = -- ] && shift
    if [ -n "$selection" ]; then set -- --namespace "$selection" build --cache-from "type=registry,ref=$cache_ref" --cache-to "type=registry,ref=$cache_ref,mode=max" "$@"
    else set -- build --cache-from "type=registry,ref=$cache_ref" --cache-to "type=registry,ref=$cache_ref,mode=max" "$@"
    fi
    exec_nerdctl "$@"
    ;;
  image_push) exec_nerdctl --namespace "$selection" push "$@" ;;
  image_pull) exec_nerdctl --namespace "$selection" pull "$@" ;;
  image_save) archive=$1; shift; exec_nerdctl --namespace "$selection" save -o "$archive" "$@" ;;
  image_load) exec_nerdctl --namespace "$selection" load -i "$1" ;;
  volume_exists) run_nerdctl --namespace "$selection" volume inspect "$1" >/dev/null 2>&1 ;;
  volume_create) exec_nerdctl --namespace "$selection" volume create "$1" ;;
  volume_export) exec_nerdctl --namespace "$selection" run --rm -v "$1:/volume:ro" "$volume_image" tar -C /volume -cf - . ;;
  volume_import) exec_nerdctl --namespace "$selection" run --rm -i -v "$1:/volume" "$volume_image" tar -C /volume -xf - ;;
  *) exit 2 ;;
esac
