          },
          {
            "name": "doctor"
          },
          {
            "name": "build"
          },
          {
            "name": "image_push"
          },
          {
            "name": "image_pull"
          },
          {
            "name": "image_save"
          },
          {
            "name": "image_load"
          },
          {
            "name": "volume_exists"
          },
          {
            "name": "volume_create"
          },
          {
            "name": "volume_export"
          },
          {
            "name": "volume_import"
          }
        ]
      }
    ]
  },
  "artifacts": [
