#!/usr/bin/env sh
set -eu

operation=${1:-}
[ "$#" -eq 0 ] || shift
selection=${1:-}
[ "$#" -eq 0 ] || shift
[ "${1:-}" != -- ] || shift

orbctl=${EXT_ORBSTACK_CLI:-}
if [ -z "$orbctl" ] && [ -x "$HOME/.orbstack/bin/orbctl" ]; then orbctl="$HOME/.orbstack/bin/orbctl"; fi
if [ -z "$orbctl" ]; then orbctl=$(command -v orbctl 2>/dev/null || :); fi

case "$operation" in
  list) [ -n "$orbctl" ] && printf 'local\n' ;;
  validate) [ "$selection" = local ] && [ -n "$orbctl" ] || { printf 'orbstack: OrbStack is unavailable\n' >&2; exit 1; } ;;
  run)
    [ -n "$orbctl" ] || { printf 'orbstack: orbctl is unavailable\n' >&2; exit 127; }
    case "${1:-}" in
      status)
        if status=$("$orbctl" status 2>&1); then printf '%s\n' "$status"
        elif [ "$status" = Stopped ]; then printf 'Stopped\n'
        else printf '%s\n' "$status" >&2; exit 1
        fi
        ;;
      start|stop) exec "$orbctl" "$1" ;;
      *) printf 'orbstack: expected status, start, or stop\n' >&2; exit 2 ;;
    esac
    ;;
  doctor)
    if [ -z "$orbctl" ]; then printf 'skip OrbStack is not installed\n'; exit 0; fi
    if status=$("$orbctl" status 2>&1); then
      printf 'ok   OrbStack status: %s\n' "$status"
      case "$status" in
        *[Rr]unning*) "$orbctl" doctor ;;
      esac
    elif [ "$status" = Stopped ]; then
      printf 'ok   OrbStack is stopped\n'
    else
      printf 'fail OrbStack status: %s\n' "$status"
      exit 1
    fi
    ;;
  *) exit 2 ;;
esac
