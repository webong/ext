#!/bin/sh
set -eu

operation=${1:-}
[ "$#" -gt 0 ] && shift

real_php() {
  if [ -n "${CTX_ADAPTER_REAL_COMMAND:-}" ] && [ -x "$CTX_ADAPTER_REAL_COMMAND" ]; then
    printf '%s\n' "$CTX_ADAPTER_REAL_COMMAND"
    return
  fi
  if [ -n "${CTX_EXECUTABLE:-}" ] && [ -x "$CTX_EXECUTABLE" ]; then
    resolved=$("$CTX_EXECUTABLE" real php 2>/dev/null || true)
    if [ -n "$resolved" ] && [ -x "$resolved" ]; then
      printf '%s\n' "$resolved"
      return
    fi
  fi
  ctx_command=$(command -v ctx 2>/dev/null || true)
  if [ -n "$ctx_command" ] && [ -x "$ctx_command" ]; then
    resolved=$("$ctx_command" real php 2>/dev/null || true)
    if [ -n "$resolved" ] && [ -x "$resolved" ]; then
      printf '%s\n' "$resolved"
      return
    fi
  fi
  command -v php 2>/dev/null || true
}

# One line per usable PHP: selection, executable, version, installers.
# CTX passes every copy it found in CTX_PROGRAMS (see the adapter API); outside
# CTX only the PHP on PATH is known. A copy whose version cannot be read is not
# usable and is left out.
candidates() {
  tab=$(printf '\t')
  if [ "${CTX_PROGRAMS+set}" = set ]; then
    printf '%s\n' "$CTX_PROGRAMS" | awk -F '\t' '$1 == "php" && $2 != "" { print ($6 == 1 ? 0 : 1) "\t" $2 "\t" $5 }' | sort -s -k1,1n |
      while IFS="$tab" read -r rank executable installers; do
        printf '%s\t%s\n' "$executable" "$installers"
      done
    return
  fi
  executable=$(real_php)
  [ -n "$executable" ] && printf '%s\t\n' "$executable"
  return 0
}

inventory() {
  tab=$(printf '\t')
  candidates | while IFS="$tab" read -r executable installers; do
    [ -x "$executable" ] || continue
    version=$("$executable" -r 'echo PHP_VERSION;' 2>/dev/null || true)
    [ -n "$version" ] || continue
    selection=$(printf '%s\n' "$version" | awk -F. '{print $1 "." $2}')
    printf '%s\t%s\t%s\t%s\n' "$selection" "$executable" "$version" "${installers:-path}"
  done | awk -F '\t' '!seen[$1]++'
}

find_record() {
  wanted=$1
  inventory | awk -F '\t' -v wanted="$wanted" '$1 == wanted { print; exit }'
}

case "$operation" in
  list)
    inventory | awk -F '\t' 'NF >= 4 && !seen[$1]++ { print $1 }'
    ;;
  observe)
    tab=$(printf '\t')
    separator=
    printf '{"version":1,"contexts":['
    inventory | while IFS="$tab" read -r selection executable version manager; do
      [ -n "$selection" ] || continue
      printf '%s{"selection":"%s","attributes":{"kind":"php","version":"%s","isolation":"host","manager":"%s"}}' "$separator" "$selection" "$version" "$manager"
      separator=,
    done
    printf ']}\n'
    ;;
  validate)
    selection=${1:-}
    [ -n "$selection" ] && [ -n "$(find_record "$selection")" ] || { printf 'php: PHP %s is not installed\n' "${selection:-<empty>}" >&2; exit 1; }
    ;;
  doctor)
    selection=${1:-}
    if [ -n "$selection" ]; then
      record=$(find_record "$selection")
      [ -n "$record" ] || { printf 'php: PHP %s is not installed\n' "$selection" >&2; exit 1; }
      tab=$(printf '\t')
      executable=$(printf '%s\n' "$record" | awk -F '\t' '{print $2}')
    else
      executable=$(real_php)
    fi
    [ -n "$executable" ] && [ -x "$executable" ] || { printf 'php: PHP CLI is not installed\n' >&2; exit 127; }
    "$executable" -v
    ;;
  run)
    selection=
    if [ "$#" -gt 0 ] && [ "$1" != "--" ]; then selection=$1; shift; fi
    [ "${1:-}" = "--" ] && shift
    if [ -n "$selection" ]; then
      record=$(find_record "$selection")
      [ -n "$record" ] || { printf 'php: PHP %s is not installed\n' "$selection" >&2; exit 1; }
      executable=$(printf '%s\n' "$record" | awk -F '\t' '{print $2}')
    else
      executable=$(real_php)
    fi
    [ -n "$executable" ] && [ -x "$executable" ] || { printf 'php: PHP CLI is not installed\n' >&2; exit 127; }
    exec "$executable" "$@"
    ;;
  *) exit 2 ;;
esac
