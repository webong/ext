#!/usr/bin/env sh
set -eu

podman=${EXT_ADAPTER_REAL_COMMAND:-}
[ -n "$podman" ] && [ -x "$podman" ] || { printf 'podman: Podman CLI is not installed\n' >&2; exit 127; }
operation=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
selection=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
if [ "${1:-}" = -- ]; then shift; fi
volume_image=${EXT_VOLUME_IMAGE:-alpine:3.21}

connections() { "$podman" system connection list --format '{{.Name}}'; }
has_connection() { connections | grep -Fxq "$1"; }
has_run_override() {
  if [ -n "${CONTAINER_CONNECTION:-}" ] || [ -n "${CONTAINER_HOST:-}" ] || [ "${1:-}" = machine ]; then return 0; fi
  [ "${1:-}" = system ] && [ "${2:-}" = connection ] && return 0
  for argument in "$@"; do case "$argument" in --connection|--connection=*|--url|--url=*|--remote|-c|-c?*|-r|-r?*) return 0;; esac; done
  return 1
}

case "$operation" in
  list) connections ;;
  validate) has_connection "$selection" || { printf 'podman: unknown connection %s\n' "$selection" >&2; exit 1; } ;;
  doctor) if [ -n "$selection" ]; then has_connection "$selection"; else "$podman" version >/dev/null 2>&1; fi ;;
  run) if [ -z "$selection" ] || has_run_override "$@"; then exec "$podman" "$@"; else exec "$podman" --connection "$selection" "$@"; fi ;;
  build)
    [ "${1:-}" = --cache-ref ] && [ "$#" -ge 2 ] || exit 2
    cache_ref=$2; shift 2; [ "${1:-}" = -- ] && shift
    if [ -n "$selection" ]; then set -- --connection "$selection" build --layers --cache-from "$cache_ref" --cache-to "$cache_ref" "$@"
    else set -- build --layers --cache-from "$cache_ref" --cache-to "$cache_ref" "$@"
    fi
    exec "$podman" "$@"
    ;;
  image_push) exec "$podman" --connection "$selection" image push "$@" ;;
  image_pull) exec "$podman" --connection "$selection" image pull "$@" ;;
  image_save) archive=$1; shift; exec "$podman" --connection "$selection" image save -o "$archive" "$@" ;;
  image_load) exec "$podman" --connection "$selection" image load -i "$1" ;;
  volume_exists) "$podman" --connection "$selection" volume inspect "$1" >/dev/null 2>&1 ;;
  volume_create) exec "$podman" --connection "$selection" volume create "$1" ;;
  volume_export) exec "$podman" --connection "$selection" run --rm -v "$1:/volume:ro" "$volume_image" tar -C /volume -cf - . ;;
  volume_import) exec "$podman" --connection "$selection" run --rm -i -v "$1:/volume" "$volume_image" tar -C /volume -xf - ;;
  *) exit 2 ;;
esac
