#!/usr/bin/env sh
set -eu
operation=${1:-}
selection=${2:-}
psql=$(command -v psql 2>/dev/null || true)
[ -n "$psql" ] || { printf 'postgres: psql is not installed\n' >&2; exit 127; }
case "$operation" in
  configure)
    shift 2; [ "${1:-}" = -- ] && shift
    service_file=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --service-file) [ "$#" -ge 2 ] || exit 2; service_file=$2; shift 2 ;;
        --service-file=*) service_file=${1#--service-file=}; shift ;;
        *) printf 'postgres: unsupported selection option %s\n' "$1" >&2; exit 2 ;;
      esac
    done
    printf 'postgres_service\t%s\n' "$selection"
    if [ -n "$service_file" ]; then printf 'postgres_service_file\t%s\n' "$service_file"; fi
    ;;
  validate|doctor) : ;;
  run)
    shift 2; [ "${1:-}" = -- ] && shift
    command_name=${EXT_ADAPTER_COMMAND:-psql}
    [ "$command_name" = postgres ] && command_name=psql
    client=$(command -v "$command_name" 2>/dev/null || true)
    [ -n "$client" ] || { printf 'postgres: %s is not installed\n' "$command_name" >&2; exit 127; }
    service=${PGSERVICE:-$selection}
    service_file=${PGSERVICEFILE:-${EXT_ADAPTER_VALUE_POSTGRES_SERVICE_FILE:-}}
    if [ -n "$service_file" ]; then PGSERVICE="$service" PGSERVICEFILE="$service_file" "$client" "$@"
    else PGSERVICE="$service" "$client" "$@"
    fi
    ;;
  *) exit 2 ;;
esac
