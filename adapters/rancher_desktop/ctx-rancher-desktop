#!/usr/bin/env sh
set -eu

operation=${1:-}
[ "$#" -eq 0 ] || shift
selection=${1:-}
[ "$#" -eq 0 ] || shift
[ "${1:-}" != -- ] || shift
platform=${EXT_PLATFORM:-$(uname -s)}

rdctl=${EXT_RANCHER_RDCTL:-}
if [ -z "$rdctl" ] && [ -x "$HOME/.rd/bin/rdctl" ]; then rdctl="$HOME/.rd/bin/rdctl"; fi
if [ -z "$rdctl" ]; then rdctl=$(command -v rdctl 2>/dev/null || :); fi
engine_from_json() {
  awk '
    /"containerEngine"[[:space:]]*:/ {
      section=1
      position=index($0, "\"containerEngine\"")
      $0=substr($0, position+length("\"containerEngine\""))
    }
    section && /"name"[[:space:]]*:/ {
      position=index($0, "\"name\"")
      $0=substr($0, position+length("\"name\""))
      sub(/^[[:space:]]*:[[:space:]]*"/, "")
      sub(/".*$/, "")
      print $0
      exit
    }
  '
}

case "$operation" in
  list) [ -n "$rdctl" ] && printf 'local\n' ;;
  validate)
    [ "$selection" = local ] && [ -n "$rdctl" ] || { printf 'rancher_desktop: Rancher Desktop is unavailable\n' >&2; exit 1; }
    ;;
  run)
    [ -n "$rdctl" ] || { printf 'rancher_desktop: rdctl is unavailable\n' >&2; exit 127; }
    case "${1:-}" in
      status) exec "$rdctl" info ;;
      start) exec "$rdctl" start ;;
      stop) exec "$rdctl" shutdown ;;
      *) printf 'rancher_desktop: expected status, start, or stop\n' >&2; exit 2 ;;
    esac
    ;;
  doctor)
    if [ -z "$rdctl" ]; then printf 'skip Rancher Desktop is not installed\n'; exit 0; fi
    failures=0
    if information=$("$rdctl" info 2>&1); then
      printf 'ok   Rancher Desktop is running\n'
      inspect_logs=0
    elif printf '%s\n' "$information" | grep -Eq 'state "?(Stopped|ShutDown)"?'; then
      printf 'ok   Rancher Desktop is stopped\n'
      inspect_logs=0
    else
      printf 'fail Rancher Desktop is not running: %s\n' "$(printf '%s\n' "$information" | head -n 1)"
      failures=1
      inspect_logs=1
    fi
    engine=
    if settings=$("$rdctl" list-settings 2>/dev/null); then
      engine=$(printf '%s\n' "$settings" | engine_from_json)
    fi
    if [ -z "$engine" ] && [ "$platform" = Darwin ] && [ -f "$HOME/Library/Preferences/rancher-desktop/settings.json" ]; then
      engine=$(engine_from_json < "$HOME/Library/Preferences/rancher-desktop/settings.json")
    fi
    case "$engine" in
      containerd) printf 'ok   containerd engine; Docker Buildx/Compose links are not used by nerdctl\n' ;;
      moby|docker)
        for plugin in buildx compose; do
          global="$HOME/.docker/cli-plugins/docker-$plugin"
          expected="$HOME/.rd/bin/docker-$plugin"
          actual=$(readlink "$global" 2>/dev/null || :)
          if [ "$actual" != "$expected" ]; then
            printf 'warn Docker %s global link is not Rancher-owned; ctx can route a manager-specific plugin directory\n' "$plugin"
          fi
        done
        ;;
      *) printf 'info Rancher engine unknown; Docker plugin links were not assessed\n' ;;
    esac
    if [ "$platform" = Darwin ] && [ "$inspect_logs" -eq 1 ]; then
      logdir="$HOME/Library/Application Support/rancher-desktop/lima/0"
      background="$HOME/Library/Logs/rancher-desktop/background.log"
      if [ -d "$logdir" ]; then
        available=$(df -Pk "$logdir" 2>/dev/null | awk 'NR==2 { print $4 }')
        if [ -n "$available" ] && [ "$available" -lt 5242880 ]; then
          printf 'warn Rancher Desktop host volume has less than 5 GiB available; free space before retrying\n'
        fi
        if [ -f "$logdir/serialv.log" ] && tail -c 262144 "$logdir/serialv.log" | grep -Eq 'EXT4-fs.*(potential data loss|error -5|Filesystem error recorded|Marked fs in need of filesystem check)'; then
          printf 'warn Last recorded Rancher VM boot logged EXT4 filesystem errors; back up data before repair or reset\n'
        fi
        if [ -f "$logdir/ha.stdout.log" ] && tail -c 262144 "$logdir/ha.stdout.log" | grep -Eq 'Failed to wait for guest SSH server'; then
          printf 'fail Last recorded Rancher VM boot did not reach guest SSH; plugin links are not the cause\n'
          failures=1
        fi
      fi
      if [ -f "$background" ] && tail -c 262144 "$background" | LC_ALL=C tr -d '\000' | awk '
        /Rancher Desktop was unable to start:/ { found=1; k3s=0; segfault=0; failed=0 }
        found && /rc-service --ifnotstarted k3s start/ { k3s=1 }
        found && /Segmentation fault/ { segfault=1 }
        found && /k3s failed to start/ { failed=1 }
        END { exit !(found && k3s && segfault && failed) }
      '; then
        printf 'fail Last recorded Rancher startup reached the guest, but k3s segfaulted while starting; inspect Rancher Desktop background.log and k3s.log\n'
        failures=1
      fi
    fi
    exit "$failures"
    ;;
  *) exit 2 ;;
esac
