#!/usr/bin/env sh
set -eu

find_safari() {
  [ "${CTX_PLATFORM:-$(uname -s)}" = Darwin ] || return 1
  opener=$(command -v open 2>/dev/null || true)
  [ -n "$opener" ] || return 1
  if "$opener" -Ra Safari >/dev/null 2>&1; then SAFARI_APP=Safari; return 0; fi
  for candidate in "$HOME/Applications/Safari.app" /Applications/Safari.app /System/Applications/Safari.app; do
    if [ -d "$candidate" ] && "$opener" -Ra "$candidate" >/dev/null 2>&1; then SAFARI_APP=$candidate; return 0; fi
  done
  return 1
}

operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
    helper=$(dirname "$0")/ctx-safari-share
    exec "$helper" "$@"
    ;;
  list) find_safari || exit 0; printf 'safari:default\n' ;;
  validate) [ "$selection" = default ] && find_safari ;;
  doctor) find_safari; [ -z "$selection" ] || [ "$selection" = default ] ;;
  open)
    [ "$selection" = default ] && find_safari || { printf 'safari: only the default context is supported\n' >&2; exit 1; }
    shift 2; [ "${1:-}" = -- ] && shift
    exec "$opener" -na "$SAFARI_APP" "$@"
    ;;
  *) exit 2 ;;
esac
