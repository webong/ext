#!/usr/bin/env sh
set -eu
platform=${CTX_PLATFORM:-$(uname -s)}
profiles_ini() {
  case "$platform" in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/zen/profiles.ini" ;;
    Linux) printf '%s\n' "$HOME/.zen/profiles.ini" ;;
    *) return 1 ;;
  esac
}
profile_names() {
  ini=$(profiles_ini) || return 0
  [ -f "$ini" ] || return 0
  awk -F= '
    /^\[Profile[0-9]+\]/ { active=1; next }
    /^\[/ { active=0 }
    active && $1 == "Name" { sub(/\r$/, "", $2); print $2 }
  ' "$ini"
}
profile_exists() {
  case "$1" in
    /*) [ -f "$1/cookies.sqlite" ] || [ -f "$1" ] ;;
    *) profile_names | awk -v wanted="$1" '$0 == wanted { found=1 } END { exit !found }' ;;
  esac
}
operation=${1:-}
selection=${2:-}
case "$operation" in
  share)
        exec "$(dirname "$0")/ctx-zen-share" "$@" ;;
  list) profile_names | while IFS= read -r name; do printf 'zen:%s\n' "$name"; done ;;
  validate) profile_exists "$selection" ;;
  doctor) if [ -z "$selection" ]; then [ -f "$(profiles_ini)" ]; else profile_exists "$selection"; fi ;;
  *) exit 2 ;;
esac
