go 1.26.0

use (
	./cmd/ext
	./examples/ledger/go
	./examples/plugins/go
	./examples/web/go
	./pkg/ext-go
	./pkg/ext-go/c2goengine
	./pkg/ext-go/cengine
	./pkg/ext-go/cgoengine
	./pkg/ext-go/core
	./pkg/ext-go/engine
	./pkg/ext-go/hashicorp
	./pkg/ext-go/wasm
	./pkg/ext-go/yaegi
	./pkg/ext-linux/net/guest
	./src/ctn
	./src/cto
	./src/cto/sandbox
	./src/ctx
	./tests/crosslang
)

// pkg/ext-go/core has no published version yet; the workspace resolves the one its modules
// require to the tree. Remove this once pkg/ext-go/core/v0.1.0 is tagged.
replace github.com/webong/ext/pkg/ext-go/core v0.1.0 => ./pkg/ext-go/core

// The cengine module (the C side and the C guest backend) has no published version yet. Remove this
// once pkg/ext-go/cengine/v0.1.0 is tagged.
replace github.com/webong/ext/pkg/ext-go/cengine v0.1.0 => ./pkg/ext-go/cengine

// CTO's sandbox module has no published tag yet. Remove this once
// src/cto/sandbox/v0.1.0 is published.
replace github.com/webong/ext/src/cto/sandbox v0.1.0 => ./src/cto/sandbox

// CTX has no published module tag; the workspace resolves its packages from the tree.
replace github.com/webong/ext/src/ctx v0.1.0 => ./src/ctx

