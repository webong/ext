// pkg/ext-go/runtime has no published version yet; the workspace resolves the one its modules
// require to the tree. Remove this once pkg/ext-go/runtime/v0.1.0 is tagged.
replace github.com/webong/ext/pkg/ext-go/runtime v0.1.0 => ./pkg/ext-go/runtime

// The ledger recorder module (pkg/ext-go/engine/ledger/recorder) has no published version yet.
// Remove this once pkg/ext-go/engine/ledger/recorder/v0.1.0 is tagged.
replace github.com/webong/ext/pkg/ext-go/engine/ledger/recorder v0.1.0 => ./pkg/ext-go/engine/ledger/recorder

// CTO's sandbox module has no published tag yet. Remove this once
// src/cto/sandbox/v0.1.0 is published.
replace github.com/webong/ext/src/cto/sandbox v0.1.0 => ./src/cto/sandbox

// CTN's bridge module tags and the updated OpenAI adapter tag are not published yet.
// The workspace resolves their new consumers to the current sources.
replace github.com/webong/ext/src/ctn/inference v0.1.0 => ./src/ctn/inference

replace github.com/webong/ext/src/ctn/model v0.1.0 => ./src/ctn/model

replace github.com/webong/ext/src/ctn/perception v0.1.0 => ./src/ctn/perception

