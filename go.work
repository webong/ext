go 1.26.0

use (
	./src/ctn
	./src/ctx
	./cmd/ext
	./adapters/chromium
	./adapters/secret_service
	./adapters/credman
	./adapters/keychain
	./adapters/git
	./adapters/systemd
	./adapters/pulseaudio
	./adapters/alsa
	./adapters/pipewire
	./adapters/x11
	./adapters/ffmpeg
	./adapters/wayland
	./adapters/wasm
	./adapters/evm
	./adapters/zen
	./adapters/waterfox
	./adapters/librewolf
	./adapters/floorp
	./adapters/whale
	./adapters/vivaldi
	./adapters/opera
	./adapters/helium
	./adapters/dia
	./adapters/comet
	./adapters/atlas
	./adapters/arc
	./adapters/brave
	./adapters/edge
	./adapters/chrome
	./adapters/firefox
	./adapters/safari
	./adapters/openai
	./adapters/ollama
	./adapters/anthropic
	./adapters/gemini
	./res/system
	./res/graph
	./res/int
	./pkg/ext-go
	./pkg/ext-go/hashicorp
	./pkg/ext-go/wasm
	./pkg/ext-go/inference
	./pkg/ext-go/model
	./pkg/ext-go/perception
	./pkg/ext-go/realtime
	./res/web
	./pkg/ext-go/engine
	./pkg/ext-go/cgoengine
	./pkg/ext-go/c2goengine
)

// New intelligence modules are used by the umbrella before their first tags.
replace github.com/webong/ext/res/int v0.1.0 => ./res/int

replace github.com/webong/ext/pkg/ext-go/model v0.1.0 => ./pkg/ext-go/model

replace github.com/webong/ext/pkg/ext-go/perception v0.1.0 => ./pkg/ext-go/perception

replace github.com/webong/ext/pkg/ext-go/realtime v0.1.0 => ./pkg/ext-go/realtime

// chromium v0.4.1 and firefox v0.3.1, which the browser adapters require, exist only as local tags and
// were never pushed. Until they are published these resolve those versions to the workspace copies.
replace github.com/webong/ext/adapters/chromium v0.4.1 => ./adapters/chromium

replace github.com/webong/ext/adapters/firefox v0.3.1 => ./adapters/firefox

// Ollama reuses the OpenAI-compatible client before its first module tag is published.
replace github.com/webong/ext/adapters/openai v0.1.0 => ./adapters/openai
