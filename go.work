go 1.26.0

use (
	./src/ctn
	./src/ctx
	./cmd/ext
	./adapters/chromium
	./adapters/secret_service
	./adapters/credman
	./adapters/keychain
	./adapters/git
	./adapters/systemd
	./adapters/pulseaudio
	./adapters/alsa
	./adapters/pipewire
	./adapters/x11
	./adapters/ffmpeg
	./adapters/wayland
	./adapters/wasm
	./adapters/evm
	./adapters/zen
	./adapters/waterfox
	./adapters/librewolf
	./adapters/floorp
	./adapters/whale
	./adapters/vivaldi
	./adapters/opera
	./adapters/helium
	./adapters/dia
	./adapters/comet
	./adapters/atlas
	./adapters/arc
	./adapters/brave
	./adapters/edge
	./adapters/chrome
	./adapters/firefox
	./adapters/safari
	./adapters/openai
	./adapters/ollama
	./adapters/anthropic
	./adapters/gemini
	./res/system
	./res/graph
	./res/int
	./pkg/ext-go
	./pkg/ext-go/hashicorp
	./pkg/ext-go/wasm
	./pkg/ext-go/inference
	./pkg/ext-go/model
	./pkg/ext-go/perception
	./pkg/ext-go/realtime
	./res/web
	./pkg/ext-go/engine
	./pkg/ext-go/cgoengine
	./pkg/ext-go/c2goengine
)

// New intelligence modules are used by the umbrella before their first tags.
replace github.com/webong/ext/res/int v0.1.0 => ./res/int

replace github.com/webong/ext/pkg/ext-go/model v0.1.0 => ./pkg/ext-go/model

replace github.com/webong/ext/pkg/ext-go/perception v0.1.0 => ./pkg/ext-go/perception

replace github.com/webong/ext/pkg/ext-go/realtime v0.1.0 => ./pkg/ext-go/realtime

// Ollama reuses the OpenAI-compatible client before its first module tag is published.
replace github.com/webong/ext/adapters/openai v0.1.0 => ./adapters/openai

// The umbrella round (engine v0.2.0 and the modules below) is not tagged yet. These resolve those versions to the
// workspace copies; delete each once its tag exists.
replace github.com/webong/ext/pkg/ext-go/engine v0.2.0 => ./pkg/ext-go/engine

replace github.com/webong/ext/pkg/ext-go/cgoengine v0.2.0 => ./pkg/ext-go/cgoengine

replace github.com/webong/ext/pkg/ext-go/c2goengine v0.2.0 => ./pkg/ext-go/c2goengine

replace github.com/webong/ext/pkg/ext-go/hashicorp v0.3.2 => ./pkg/ext-go/hashicorp

replace github.com/webong/ext/pkg/ext-go/inference v0.1.0 => ./pkg/ext-go/inference

replace github.com/webong/ext/pkg/ext-go v0.10.0 => ./pkg/ext-go

replace github.com/webong/ext/adapters/anthropic v0.1.0 => ./adapters/anthropic

replace github.com/webong/ext/adapters/gemini v0.1.0 => ./adapters/gemini

replace github.com/webong/ext/adapters/ollama v0.1.0 => ./adapters/ollama

replace github.com/webong/ext/adapters/git v0.2.2 => ./adapters/git

replace github.com/webong/ext/adapters/wasm v0.2.2 => ./adapters/wasm

replace github.com/webong/ext/adapters/evm v0.2.2 => ./adapters/evm
