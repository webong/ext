go 1.26.0

use (
	./cmd/ext
	./examples/ledger/go
	./examples/plugins/go
	./examples/web/go
	./pkg/ext-go
	./pkg/ext-go/c2goengine
	./pkg/ext-go/cengine
	./pkg/ext-go/cgoengine
	./pkg/ext-go/core
	./pkg/ext-go/engine
	./pkg/ext-go/hashicorp
	./pkg/ext-go/wasm
	./pkg/ext-go/yaegi
	./src/ctn/contract
	./res/system
	./res/system/service/network/linux/guest
	./res/web/host
	./src/ctn
	./src/ctn/inference
	./src/ctn/model
	./src/ctn/perception
	./src/ctn/realtime
	./src/cto
	./src/cto/sandbox
	./src/ctx
	./tests/crosslang
)

// pkg/ext-go/core has no published version yet; the workspace resolves the one its modules
// require to the tree. Remove this once pkg/ext-go/core/v0.1.0 is tagged.
replace github.com/webong/ext/pkg/ext-go/core v0.1.0 => ./pkg/ext-go/core

// The cengine module (the C side and the C guest backend) has no published version yet. Remove this
// once pkg/ext-go/cengine/v0.1.0 is tagged.
replace github.com/webong/ext/pkg/ext-go/cengine v0.1.0 => ./pkg/ext-go/cengine

// CTO's sandbox module has no published tag yet. Remove this once
// src/cto/sandbox/v0.1.0 is published.
replace github.com/webong/ext/src/cto/sandbox v0.1.0 => ./src/cto/sandbox

// CTN's bridge module tags are not published yet.
// The workspace resolves their new consumers to the current sources.
replace github.com/webong/ext/src/ctn/contract v0.1.0 => ./src/ctn/contract
replace github.com/webong/ext/src/ctn/inference v0.1.0 => ./src/ctn/inference

replace github.com/webong/ext/src/ctn/model v0.1.0 => ./src/ctn/model

replace github.com/webong/ext/src/ctn/perception v0.1.0 => ./src/ctn/perception

replace github.com/webong/ext/src/ctn/realtime v0.1.0 => ./src/ctn/realtime

