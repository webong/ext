# Drives the ext-ledger command as a shell would. Run by ctest with -DLEDGER=<command> -DWORK=<dir>.
file(REMOVE_RECURSE "${WORK}")

function(ledger expect_code expect_output)
  execute_process(COMMAND "${LEDGER}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code STREQUAL "${expect_code}")
    message(FATAL_ERROR "ext-ledger ${ARGN}: exit ${code}, want ${expect_code}\n${out}${err}")
  endif()
  if(expect_output AND NOT out MATCHES "${expect_output}" AND NOT err MATCHES "${expect_output}")
    message(FATAL_ERROR "ext-ledger ${ARGN}: output does not match ${expect_output}\n${out}${err}")
  endif()
endfunction()

set(ns cmd.example)
ledger(2 "not_found" snapshot "${WORK}" ${ns})
ledger(0 "" register "${WORK}" "{\"namespace\":\"${ns}\",\"version\":\"1\"}")
ledger(0 "\"cursor\":1" apply "${WORK}" "{\"namespace\":\"${ns}\",\"vertices\":[{\"id\":\"a\",\"kind\":\"${ns}/node\"},{\"id\":\"b\",\"kind\":\"${ns}/node\"}]}")
ledger(0 "\"cursor\":2" apply "${WORK}" "{\"namespace\":\"${ns}\",\"edges\":[{\"id\":\"ab\",\"from\":\"a\",\"to\":\"b\",\"type\":\"${ns}/link\"}]}")
ledger(0 "\"revision\":2" snapshot "${WORK}" ${ns})
ledger(0 "\"kind\":\"${ns}/node\"" get-vertex "${WORK}" ${ns} a)
ledger(2 "not_found" get-edge "${WORK}" ${ns} missing)
ledger(0 "\"id\":\"ab\"" query-edges "${WORK}" "{\"namespace\":\"${ns}\",\"from\":\"a\",\"limit\":5}")
ledger(0 "\"vertices\":\\[" traverse "${WORK}" ${ns} a --depth 2)
ledger(0 "\"cursor\":2" changes "${WORK}" ${ns} --after 1)
ledger(1 "invalid" changes "${WORK}" ${ns} --limit 0)
ledger(5 "denied" apply "${WORK}" "{\"namespace\":\"${ns}\",\"vertices\":[{\"id\":\"c\",\"kind\":\"${ns}/node\",\"attributes\":{\"api_key\":\"x\"}}]}")
ledger(0 "\"sha256\":\"ffa0f502af1503ddffc8bfa1258cc65f62cd84d1d22deab162495f9dd4a9bcc1\"" fingerprint "{\"namespace\":\"test.example\"}")
ledger(64 "usage" snapshot)
file(REMOVE_RECURSE "${WORK}")
