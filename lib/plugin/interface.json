  "objects": {
    "library": {
      "about": "Handle 0, the library itself: the pure services (services.md), the digests and the trust records. It is never opened or closed.",
      "operations": {
        "describe": {"about": "This description.", "input": {"type": "object"}, "output": {"type": "object"}},
        "code_name": {"input": {"type": "object", "required": ["code"], "properties": {"code": {"type": "integer"}}}, "output": {"type": "string"}},
        "directory_digest": {"input": {"type": "object", "required": ["root"], "properties": {"root": {"type": "string"}}}, "output": {"type": "string"}},
        "artifact_digest": {"input": {"type": "object", "required": ["root", "path"], "properties": {"root": {"type": "string"}, "path": {"type": "string"}, "tree": {"type": "boolean"}}}, "output": {"type": "string"}},
        "store_digest": {"input": {"type": "object", "required": ["root", "id"], "properties": {"root": {"type": "string"}, "id": {"type": "string"}}}, "output": {"type": "string"}},
        "package_verify": {"input": {"type": "object", "required": ["manifest", "root"], "properties": {"manifest": {"type": "object"}, "root": {"type": "string"}}}, "output": {}},
        "trust_state": {"input": {"type": "object", "required": ["path", "scope", "id", "digest"], "properties": {"path": {"type": "string"}, "scope": {"type": "string"}, "id": {"type": "string"}, "digest": {"type": "string"}}}, "output": {"type": "string"}},
        "trust_record": {"input": {"type": "object", "required": ["path", "scope", "id", "digest"], "properties": {"path": {"type": "string"}, "scope": {"type": "string"}, "id": {"type": "string"}, "digest": {"type": "string"}}}, "output": {}},
        "trust_revoke": {"input": {"type": "object", "required": ["path", "scope", "id"], "properties": {"path": {"type": "string"}, "scope": {"type": "string"}, "id": {"type": "string"}}}, "output": {}},
        "resource.call.request.validate": {"about": "Validate an explicit resource call request before launch.", "input": {"type": "object", "required": ["resource", "contract", "operation", "input"]}, "output": {"type": "object"}},
        "resource.result.validate": {"about": "Validate a result against the selected resource output schema.", "input": {"type": "object", "required": ["selection", "payload"]}, "output": {}},
        "resource.call.validate": {"about": "Validate a payload against a selected resource operation schema. No invocation or authorization.", "input": {"type": "object", "required": ["selection", "payload"]}, "output": {}},
        "resource.operation.select": {"about": "Select a resource-advertised operation also declared by its provider. No invocation or authorization.", "input": {"type": "object", "required": ["descriptor", "inspection", "requirement"]}, "output": {"type": "object"}},
        "resource.error.validate": {"about": "Validate an ext.resource/v1 discovery error against its request; preserves the plugin error envelope.", "input": {"type": "object", "required": ["operation", "request", "error"]}, "output": {"type": "object"}},
        "resource.response.validate": {"about": "Validate ext.resource/v1 page or inspection against the selected provider and request; no invocation or authorization.", "input": {"type": "object", "required": ["operation", "provider", "request", "response"]}, "output": {"type": "object"}},
        "resource.request.validate": {"about": "Validate ext.resource/v1 list or inspect input; returns the request unchanged, without invoking or authorizing a provider.", "input": {"type": "object", "required": ["operation", "request"]}, "output": {"type": "object"}},
        "bundle.plan": {"about": "Validate a pinned ext.bundle/v1 package selection and resolve its complete dependency graph; no download or trust grant.", "input": {"type": "object", "required": ["apiVersion", "target", "packages"]}, "output": {"type": "object"}},
        "catalog.validate": {"about": "Validate the existing format_version 1 artifact index; this grants no trust and performs no download.", "input": {"type": "object", "required": ["format_version", "name", "packages"]}, "output": {"type": "object"}},
        "catalog.select": {"about": "Select the pinned archive for one exact os/arch target; not_found when absent.", "input": {"type": "object", "required": ["index", "target"]}, "output": {"type": "object", "required": ["url", "sha256"]}},
        "descriptor.validate": {"about": "services.md", "input": {"type": "object"}, "output": {"type": "object"}},
        "descriptor.match": {"about": "services.md", "input": {"type": "object", "required": ["selected", "actual"]}, "output": {}},
        "descriptor.select": {"about": "services.md", "input": {"type": "object", "required": ["candidates", "requirement"]}, "output": {"type": "object"}},
        "descriptor.requirements": {"about": "services.md", "input": {"type": "object", "required": ["descriptor", "requirements"]}, "output": {}},
        "protocol.negotiate": {"about": "services.md", "input": {"type": "object", "required": ["preferred", "offered"]}, "output": {"type": "string"}},
        "request.validate": {"about": "services.md", "input": {"type": "object", "required": ["descriptor", "request"]}, "output": {"type": "object"}},
        "response.validate": {"about": "services.md", "input": {"type": "object", "required": ["response", "requestID"]}, "output": {"type": "object"}},
        "schema.validate": {"about": "services.md", "input": {"type": "object"}, "output": {"type": "object"}},
        "schema.check": {"about": "services.md", "input": {"type": "object", "required": ["schema", "value"]}, "output": {}},
        "route.resolve": {"about": "services.md", "input": {"type": "object", "required": ["hosts", "guests"]}, "output": {"type": "object"}},
        "package.validate": {"about": "services.md", "input": {"type": "object"}, "output": {"type": "object"}},
        "package.select": {"about": "services.md", "input": {"type": "object", "required": ["manifest", "name", "environment"]}, "output": {"type": "object"}},
        "package.routes": {"about": "services.md", "input": {"type": "object", "required": ["packages", "os", "arch", "consumer"]}, "output": {"type": "array"}},
        "package.execution": {"about": "Compile the reachable routed execution graph with provider-first startup order; no execution or authority.", "input": {"type": "object", "required": ["packages", "os", "arch", "root"]}, "output": {"type": "object", "required": ["root", "nodes", "order"]}},
        "package.graph": {"about": "Resolve packages for a target and project declarative facts into an Ext graph schema and transaction; no execution, trust or storage.", "input": {"type": "object", "required": ["packages", "os", "arch"]}, "output": {"type": "object", "required": ["schema", "transaction"]}},
        "package.resolve_for": {"about": "services.md", "input": {"type": "object", "required": ["packages", "os", "arch"]}, "output": {"type": "object"}},
        "package.resolve": {"about": "services.md", "input": {"type": "array"}, "output": {"type": "object"}},
        "frame.validate": {"about": "services.md", "input": {"type": "object"}, "output": {"type": "object"}},
        "endpoint.check": {"about": "services.md", "input": {"type": "object"}, "output": {"type": "object"}},
        "endpoint.validate": {"about": "services.md", "input": {"type": "object", "required": ["endpoint", "policy"]}, "output": {"type": "object"}}
      }
    },
    "execution_graph": {
      "about": "Owns a reviewed process-provider graph and its private copies. Application owns source writer coordination and policy. Close stops consumers before providers; copies survive active calls and are removed last.",
      "config": {
        "type": "object",
        "required": [
          "packages",
          "root",
          "os",
          "arch",
          "temp_root"
        ]
      },
      "operations": {
        "observe": {"about": "Complete live session observations, with random instance-qualified session IDs, selected identity/contract/routes and child PID locators. Closed unless every host is ready.","input": {"type": "object"},"output": {"type": "array"}},
        "snapshot": {"about": "Project sessions, process references and routes into a complete dedicated namespace. processes must match observe order and session/PID and contain ledger process_identity references. Caller owns correlation and namespace; facts grant no authority.","input": {"type": "object","required": ["namespace","processes"],"properties": {"namespace": {"type": "string"},"processes": {"type": "array"}}},"output": {"type": "object"}},
        "plan": {
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          }
        },
        "start": {
          "input": {
            "type": "object",
            "required": [
              "reviews"
            ],
            "properties": {
              "reviews": {
                "type": "array"
              },
              "timeout_ms": {
                "type": "integer"
              }
            }
          },
          "output": {}
        },
        "call": {
          "input": {
            "type": "object",
            "required": [
              "call"
            ]
          },
          "output": {
            "type": "object"
          }
        },
        "events": {
          "input": {
            "type": "object",
            "properties": {
              "timeout_ms": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              }
            }
          },
          "output": {
            "type": "array"
          }
        },
        "answer": {
          "input": {
            "type": "object",
            "required": [
              "ticket"
            ]
          },
          "output": {}
        },
        "sequence": {
          "input": {
            "type": "object"
          },
          "output": {
            "type": "integer"
          }
        }
      },
      "events": {
        "reverse_authorize": {
          "answer": "allow",
          "data": {
            "type": "object",
            "required": [
              "consumer",
              "provider",
              "request"
            ]
          },
          "about": "An active reverse request with its exact consumer and provider identities. Denied unless the application answers allow."
        }
      }
    },
    "package_writer": {
      "about": "An exclusive cooperating-writer directory at root/.package-write.lock. Open fails with exists on contention; close releases after checking ownership. Protect the home from hostile mutation. No automatic stale-lock recovery. Hold across planning, publication and trust changes; store operations do not acquire it implicitly.",
      "config": {"type": "object", "required": ["object", "root"], "properties": {"object": {"const": "package_writer"}, "root": {"type": "string"}}},
      "operations": {}
    },
    "store": {
      "about": "An installed package store at one root.",
