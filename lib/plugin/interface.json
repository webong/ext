        "verify": {"input": {"type": "object"}, "output": {}},
        "list_unverified": {"input": {"type": "object"}, "output": {"type": "array"}},
        "snapshot": {"about": "Copy a digest-reviewed package into this private store without replacement or trust; caller owns writer coordination and cleanup.", "input": {"type": "object", "required": ["source", "id", "reviewed_digest"], "properties": {"source": {"type": "string"}, "id": {"type": "string"}, "reviewed_digest": {"type": "string"}}}, "output": {"type": "object"}},
        "resolve_entrypoint": {"input": {"type": "object", "required": ["id", "contract", "version", "protocol"], "properties": {"id": {"type": "string"}, "contract": {"type": "string"}, "version": {"type": "string"}, "protocol": {"type": "string"}, "reviewed_digest": {"type": "string"}, "os": {"type": "string"}, "arch": {"type": "string"}}}, "output": {"type": "object"}}
      }
    },
    "layered": {
