{
  "about": "What a host must observe when it composes guests through a guest registry (ext_registry in ext_host.h, Registry in pkg/ext-go/engine/host). Every case opens one host per guest in 'guests', each running the relay guest described in 'guest', attaches each host to a fresh registry as a reverse source with an authorize that allows (or denies, for the guests in the case's 'reverseDeny'), gives each host a forward authorize that allows (or denies, for the guests in the case's 'forwardDeny'), registers each guest's contract and declares every edge in 'edges'. Then it runs the case's steps in order. A call step calls the named guest's operation with payload (null when absent) and timeoutMs (5000 when absent) and expects 'result', the payload returned, or 'resultError', a result of the form {\"error\": {...}} whose error code is one of the names listed (the message is not compared). An unregister step unregisters the named guest's contract. Hosts are closed and the registry freed after the last step.",
  "guest": {
    "about": "The relay guest serves one contract, {name: <the guest's contract>, version: v1}, with the operations echo, fail, slow and relay, and declares the reverse contract in 'reverse'. echo returns its payload; fail returns the public error in 'failError'; slow waits payload.ms milliseconds and returns {\"slept\": true}; relay makes one reverse call: contract 'reverse', operation payload.operation, payload payload.payload (absent when absent), scoped to the relay call (parent: its id) unless payload.scope is \"session\", with the relay call's own deadline unless payload.deadlineMs gives one that many milliseconds from now. relay returns {\"payload\": P} when the reverse call is answered with payload P (null for none), and {\"error\": E} when it is answered with error E. Its identity is {id: registry/<guest name>, revision: r1}.",
    "reverse": {"name": "registry.ask", "version": "v1", "operations": ["echo-b", "fail-b", "slow-b", "relay-b", "echo-a", "relay-a", "echo-c", "relay-c", "missing", "unrouted"]},
    "failError": {"code": "busy", "message": "try later", "retryAfterMilliseconds": 10}
  },
  "guests": {"a": "registry.a", "b": "registry.b", "c": "registry.c"},
  "edges": [
    {"from": {"name": "registry.ask", "version": "v1", "operation": "echo-b"}, "to": {"name": "registry.b", "version": "v1", "operation": "echo"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "fail-b"}, "to": {"name": "registry.b", "version": "v1", "operation": "fail"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "slow-b"}, "to": {"name": "registry.b", "version": "v1", "operation": "slow"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "relay-b"}, "to": {"name": "registry.b", "version": "v1", "operation": "relay"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "echo-a"}, "to": {"name": "registry.a", "version": "v1", "operation": "echo"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "relay-a"}, "to": {"name": "registry.a", "version": "v1", "operation": "relay"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "echo-c"}, "to": {"name": "registry.c", "version": "v1", "operation": "echo"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "relay-c"}, "to": {"name": "registry.c", "version": "v1", "operation": "relay"}},
    {"from": {"name": "registry.ask", "version": "v1", "operation": "missing"}, "to": {"name": "registry.missing", "version": "v1", "operation": "echo"}}
  ],
  "cases": [
    {
      "name": "reverse-call-is-served-by-a-forward-call",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b", "payload": {"value": 7}}, "result": {"payload": {"value": 7}}},
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b"}, "result": {"payload": null}}
      ]
    },
    {
      "name": "session-scoped-reverse-call-is-routed",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b", "scope": "session", "payload": [1, "two"]}, "result": {"payload": [1, "two"]}}
      ]
    },
    {
      "name": "target-error-passes-through-unchanged",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "fail-b"}, "result": {"error": {"code": "busy", "message": "try later", "retryAfterMilliseconds": 10}}}
      ]
    },
    {
      "name": "undeclared-edge-is-refused",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "unrouted"}, "result": {"error": {"code": "reverse_undeclared", "message": "reverse call refused"}}}
      ]
    },
    {
      "name": "unregistered-target-is-refused",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "missing"}, "result": {"error": {"code": "reverse_unavailable", "message": "reverse call refused"}}}
      ]
    },
    {
      "name": "unregistering-a-target-refuses-its-edges",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b", "payload": 1}, "result": {"payload": 1}},
        {"unregister": "b"},
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b", "payload": 1}, "result": {"error": {"code": "reverse_unavailable", "message": "reverse call refused"}}}
      ]
    },
    {
      "name": "source-authorize-runs-first",
      "reverseDeny": ["a"],
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b"}, "result": {"error": {"code": "denied", "message": "reverse call refused"}}}
      ]
    },
    {
      "name": "target-authorize-still-applies",
      "forwardDeny": ["b"],
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-b"}, "result": {"error": {"code": "denied", "message": "reverse call refused"}}}
      ]
    },
    {
      "name": "chains-compose",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "relay-b", "payload": {"operation": "echo-c", "payload": {"depth": 2}}}, "result": {"payload": {"payload": {"depth": 2}}}}
      ]
    },
    {
      "name": "self-edge-is-refused",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "echo-a"}, "result": {"error": {"code": "denied", "message": "reverse call refused"}}}
      ]
    },
    {
      "name": "cycle-is-refused-where-it-closes",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "relay-b", "payload": {"operation": "echo-a"}}, "result": {"payload": {"error": {"code": "denied", "message": "reverse call refused"}}}},
        {"call": "a", "operation": "relay", "payload": {"operation": "relay-b", "payload": {"operation": "relay-c", "payload": {"operation": "relay-a"}}}, "result": {"payload": {"payload": {"error": {"code": "denied", "message": "reverse call refused"}}}}}
      ]
    },
    {
      "name": "deadline-carries-into-the-forward-call",
      "steps": [
        {"call": "a", "operation": "relay", "payload": {"operation": "slow-b", "deadlineMs": 300, "payload": {"ms": 1500}}, "resultError": ["expired", "operation_failed"]}
      ]
    }
  ]
}
