{
  "description": "Conformance cases for route.resolve with sandbox boundaries (docs/adr-sandboxing.md, section 5). A backend profile may state its boundary, one of the levels below; requirements may list the boundaries a consumer accepts, and an empty or absent list accepts any. A route's boundary is its guest's. Routes are tried in their usual order (direct first, then one bridge); a candidate that meets the transport requirements but not the boundaries is skipped, and when every candidate that met the transport requirements was skipped for its boundary the outcome is denied, else unsupported. Outcomes: ok, invalid, denied, unsupported. For ok the route is given in full; field order means nothing.",
  "boundaries": ["in-process", "process", "confined", "runtime", "container", "kernel"],
  "outcomes": ["ok", "invalid", "denied", "unsupported"],
  "cases": [
    {"name": "no boundary anywhere",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}]},
     "outcome": "ok",
     "route": {"protocol": "ext.io.pc/v1",
               "host": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
               "guest": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
               "concurrent": false, "nativeStreaming": false, "nativeCallbacks": false}},
    {"name": "the route carries the guest's boundary",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "process"}]},
     "outcome": "ok",
     "route": {"protocol": "ext.io.pc/v1",
               "host": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
               "guest": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "process"},
               "boundary": "process",
               "concurrent": false, "nativeStreaming": false, "nativeCallbacks": false}},
    {"name": "the host's boundary is not the route's",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "kernel"}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "process"}],
               "requirements": {"boundaries": ["kernel"]}},
     "outcome": "denied"},
    {"name": "an accepted boundary",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "runtime"}],
               "requirements": {"boundaries": ["runtime", "confined", "kernel"]}},
     "outcome": "ok",
     "route": {"protocol": "ext.io.pc/v1",
               "host": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
               "guest": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "runtime"},
               "boundary": "runtime",
               "concurrent": false, "nativeStreaming": false, "nativeCallbacks": false}},
    {"name": "an empty list accepts any boundary",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "in-process"}],
               "requirements": {"boundaries": []}},
     "outcome": "ok",
     "route": {"protocol": "ext.io.pc/v1",
               "host": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
               "guest": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "in-process"},
               "boundary": "in-process",
               "concurrent": false, "nativeStreaming": false, "nativeCallbacks": false}},
    {"name": "a boundary outside the list is denied",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "process"}],
               "requirements": {"boundaries": ["confined", "kernel"]}},
     "outcome": "denied"},
    {"name": "an unstated boundary never meets a list",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "requirements": {"boundaries": ["process"]}},
     "outcome": "denied"},
    {"name": "a bridge to a guest whose boundary is accepted",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "in-process"},
                          {"name": "wasm", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "module", "processOwner": "wazero", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "runtime"}],
               "bridges": [{"name": "ext-bridge",
                            "frontend": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
                            "backend": {"name": "wasm", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "module", "processOwner": "wazero", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "in-process"}}],
               "requirements": {"boundaries": ["runtime"]}},
     "outcome": "ok",
     "route": {"protocol": "ext.io.pc/v1",
               "host": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
               "guest": {"name": "wasm", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "module", "processOwner": "wazero", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "runtime"},
               "bridge": "ext-bridge",
               "boundary": "runtime",
               "concurrent": false, "nativeStreaming": false, "nativeCallbacks": false}},
    {"name": "transport failures are unsupported, not denied",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "process"}],
               "requirements": {"concurrent": true, "boundaries": ["kernel"]}},
     "outcome": "unsupported"},
    {"name": "denied when the only transport match has the wrong boundary",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": true, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": true, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "process"},
                          {"name": "wasm", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "module", "processOwner": "wazero", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "runtime"}],
               "bridges": [{"name": "ext-bridge",
                            "frontend": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": true, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
                            "backend": {"name": "wasm", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "module", "processOwner": "wazero", "nativeStreaming": false, "nativeCallbacks": false}}],
               "requirements": {"concurrent": true, "boundaries": ["runtime"]}},
     "outcome": "denied"},
    {"name": "an unknown boundary in a profile",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "vm"}]},
     "outcome": "invalid"},
    {"name": "a boundary is case-sensitive",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "Process"}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}]},
     "outcome": "invalid"},
    {"name": "an unknown boundary in a bridge",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "bridges": [{"name": "ext-bridge",
                            "frontend": {"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false},
                            "backend": {"name": "wasm", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "module", "processOwner": "wazero", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "sandbox"}}]},
     "outcome": "invalid"},
    {"name": "an unknown boundary in the requirements",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "kernel"}],
               "requirements": {"boundaries": ["kernel", "vm"]}},
     "outcome": "invalid"},
    {"name": "a repeated boundary in the requirements",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "kernel"}],
               "requirements": {"boundaries": ["kernel", "kernel"]}},
     "outcome": "invalid"},
    {"name": "requirements boundaries must be a list",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": "kernel"}],
               "requirements": {"boundaries": "kernel"}},
     "outcome": "invalid"},
    {"name": "a boundary must be a string",
     "input": {"hosts": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false}],
               "guests": [{"name": "jsonline", "protocols": ["ext.io.pc/v1"], "concurrent": false, "cancellation": "connection", "processOwner": "host", "nativeStreaming": false, "nativeCallbacks": false, "boundary": 1}]},
     "outcome": "invalid"}
  ]
}
