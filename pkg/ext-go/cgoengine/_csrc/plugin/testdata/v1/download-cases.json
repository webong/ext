{
  "about": "What a download of a package archive must do in any language. A test serves 'routes' from an HTTPS origin it trusts and runs a plain HTTP server beside it that must never receive a request. A route answers with 'status' (200 when absent) and 'body', or 'bodyBytes' bytes of 'x'; with a Content-Length unless 'chunked'; or with a 302 to 'redirect'. '{origin}' and '{plain}' in a redirect or a case's 'url' stand for the host and port of the two servers. A case downloads 'url' into a new file with the limit 'maxBytes' (the default limit when absent), sending 'headers' with the first request when it names any, and into a path that already holds a file when 'destinationExists'. 'expect' is ok, with the file holding 'body'; invalid, a refusal by the download rules; or failed, any other failure. A download that is not ok leaves no file, and never changes one that existed. The rules: only https URLs with a host and without user information or a fragment, for the first request and for every redirect; at most 'maxRedirects' redirects; the headers in 'absentAtLanding' are not sent with the last request the origin received; the body is no larger than the limit, whatever Content-Length says.",
  "maxRedirects": 5,
  "routes": {
    "/absolute": {
      "redirect": "https://{origin}/payload"
    },
    "/downgrade": {
      "redirect": "http://{plain}/payload"
    },
    "/hop/1": {
      "redirect": "/payload"
    },
    "/hop/2": {
      "redirect": "/hop/1"
    },
    "/hop/3": {
      "redirect": "/hop/2"
    },
    "/hop/4": {
      "redirect": "/hop/3"
    },
    "/hop/5": {
      "redirect": "/hop/4"
    },
    "/hop/6": {
      "redirect": "/hop/5"
    },
    "/large": {
      "bodyBytes": 4096
    },
    "/large-chunked": {
      "bodyBytes": 4096,
      "chunked": true
    },
    "/loop": {
      "redirect": "/loop"
    },
    "/missing": {
      "status": 404,
      "body": "no such archive"
    },
    "/payload": {
      "body": "payload"
    },
    "/server-error": {
      "status": 500,
      "body": "payload"
    },
    "/start": {
      "redirect": "/payload"
    },
    "/to-fragment": {
      "redirect": "https://{origin}/payload#part"
    },
    "/to-user": {
      "redirect": "https://user:secret@{origin}/payload"
    }
  },
  "cases": [
    {
      "name": "direct",
      "url": "https://{origin}/payload",
      "expect": "ok",
      "body": "payload"
    },
    {
      "name": "exactly-at-the-limit",
      "url": "https://{origin}/payload",
      "maxBytes": 7,
      "expect": "ok",
      "body": "payload"
    },
    {
      "name": "one-byte-over-the-limit",
      "url": "https://{origin}/payload",
      "maxBytes": 6,
      "expect": "invalid"
    },
    {
      "name": "redirect",
      "url": "https://{origin}/start",
      "expect": "ok",
      "body": "payload"
    },
    {
      "name": "absolute-redirect",
      "url": "https://{origin}/absolute",
      "expect": "ok",
      "body": "payload"
    },
    {
      "name": "credentials-do-not-follow-a-redirect",
      "url": "https://{origin}/start",
      "headers": {
        "Authorization": "Bearer secret",
        "Cookie": "session=secret",
        "Referer": "https://private.example/page"
      },
      "expect": "ok",
      "body": "payload",
      "absentAtLanding": [
        "Authorization",
        "Cookie",
        "Referer"
      ]
    },
    {
      "name": "five-redirects",
      "url": "https://{origin}/hop/5",
      "expect": "ok",
      "body": "payload"
    },
    {
      "name": "six-redirects",
      "url": "https://{origin}/hop/6",
      "expect": "invalid"
    },
    {
      "name": "redirect-loop",
      "url": "https://{origin}/loop",
      "expect": "invalid"
    },
    {
      "name": "redirect-to-http",
      "url": "https://{origin}/downgrade",
      "expect": "invalid"
    },
    {
      "name": "redirect-to-user-information",
      "url": "https://{origin}/to-user",
      "expect": "invalid"
    },
    {
      "name": "redirect-to-fragment",
      "url": "https://{origin}/to-fragment",
      "expect": "invalid"
    },
    {
      "name": "not-found",
      "url": "https://{origin}/missing",
      "expect": "failed"
    },
    {
      "name": "server-error",
      "url": "https://{origin}/server-error",
      "expect": "failed"
    },
    {
      "name": "declared-length-over-the-limit",
      "url": "https://{origin}/large",
      "maxBytes": 1024,
      "expect": "invalid"
    },
    {
      "name": "streamed-body-over-the-limit",
      "url": "https://{origin}/large-chunked",
      "maxBytes": 1024,
      "expect": "invalid"
    },
    {
      "name": "http-url",
      "url": "http://{plain}/payload",
      "expect": "invalid"
    },
    {
      "name": "user-information",
      "url": "https://user:secret@{origin}/payload",
      "expect": "invalid"
    },
    {
      "name": "fragment",
      "url": "https://{origin}/payload#part",
      "expect": "invalid"
    },
    {
      "name": "file-url",
      "url": "file:///etc/hosts",
      "expect": "invalid"
    },
    {
      "name": "no-host",
      "url": "https:///payload",
      "expect": "invalid"
    },
    {
      "name": "existing-destination",
      "url": "https://{origin}/payload",
      "destinationExists": true,
      "expect": "failed"
    }
  ]
}
