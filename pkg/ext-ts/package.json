{
  "name": "@ctx/plugin",
  "version": "0.1.0",
  "description": "Portable host and guest SDK for the ext.plugin/v1 plugin protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webong/ext.git",
    "directory": "pkg/ext-ts"
  },
