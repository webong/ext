  "bugs": { "url": "https://github.com/webong/ext/issues" },
  "keywords": ["ext", "plugin", "plugins", "sdk", "ext-plugin"],
  "type": "module",
  "files": [
    "index.mjs",
    "index.d.mts",
    "node.mjs",
    "node.d.mts",
    "engine/index.mjs",
    "engine/index.d.mts",
    "engine/addon.c",
    "engine/README.md"
  ],
  "exports": {
    ".": { "types": "./index.d.mts", "default": "./index.mjs" },
    "./node": { "types": "./node.d.mts", "default": "./node.mjs" },
    "./engine": { "types": "./engine/index.d.mts", "default": "./engine/index.mjs" }
  },
  "scripts": { "test": "node --test test.mjs frames.test.mjs router.test.mjs" },
  "engines": { "node": ">=22" }
