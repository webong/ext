{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/webong/ext/res/inference/schemas/remote-error.v1.json",
  "title": "RemoteError",
  "type": "object",
  "required": ["code"],
  "properties": {
    "code": { "type": "string" },
    "message": { "type": "string", "maxLength": 4096 },
    "retryAfter": {
      "type": "object",
      "properties": {
        "delay": { "type": "number", "minimum": 0 },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provider": { "type": "string" }
  },
  "additionalProperties": false
}
