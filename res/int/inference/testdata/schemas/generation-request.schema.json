{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/webong/ext/res/int/inference/schemas/generation-request.v1.json",
  "title": "GenerationRequest",
  "type": "object",
  "required": ["model", "messages"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/definitions/message" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/definitions/toolDefinition" }
    },
    "maxOutputTokens": { "type": "integer", "minimum": 0 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "outputSchema": { "type": "object" },
    "options": { "type": "object" },
    "limits": { "$ref": "#/definitions/limits" }
  },
  "additionalProperties": false,
  "definitions": {
    "limits": {
      "type": "object",
      "properties": {
        "maxOutputTokens": { "type": "integer", "minimum": 0 },
        "maxInputTokens": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
        "parts": { "type": "array", "items": { "$ref": "#/definitions/part" } },
        "toolCalls": { "type": "array", "items": { "$ref": "#/definitions/toolCall" } },
        "toolCallId": { "type": "string" },
        "toolName": { "type": "string" },
        "toolError": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["text", "reasoning", "refusal", "image", "audio", "video", "file", "context"] },
        "text": { "type": "string" },
        "mediaType": { "type": "string" },
        "data": { "type": "string", "contentEncoding": "base64" },
        "reference": { "$ref": "#/definitions/mediaReference" },
        "providerData": {}
      },
      "additionalProperties": false
    },
    "mediaReference": {
      "type": "object",
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "type": "string", "enum": ["url", "file"] },
        "uri": { "type": "string" }
      },
      "additionalProperties": false
    },
    "toolDefinition": {
      "type": "object",
      "required": ["name", "inputSchema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" }
      },
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" },
        "providerData": {}
      },
      "additionalProperties": false
    }
  }
}
