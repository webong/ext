{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/webong/ext/res/int/inference/schemas/speech-request.v1.json",
  "title": "SpeechRequest",
  "type": "object",
  "required": ["model", "input"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "input": { "type": "string", "minLength": 1, "maxLength": 33554432 },
    "voice": { "type": "string" },
    "format": { "type": "string" },
    "options": { "type": "object" },
    "limits": { "$ref": "#/definitions/limits" }
  },
  "additionalProperties": false,
  "definitions": {
    "limits": {
      "type": "object",
      "properties": {
        "maxOutputTokens": { "type": "integer", "minimum": 0 },
        "maxInputTokens": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
