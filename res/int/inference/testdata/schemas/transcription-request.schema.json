{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/webong/ext/res/int/inference/schemas/transcription-request.v1.json",
  "title": "TranscriptionRequest",
  "type": "object",
  "required": ["model", "audio"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "audio": { "type": "string", "contentEncoding": "base64" },
    "mediaType": { "type": "string", "pattern": "^audio/" },
    "prompt": { "type": "string", "maxLength": 1048576 },
    "language": { "type": "string", "maxLength": 128 },
    "timestamps": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["word", "segment"] }
    },
    "options": { "type": "object" },
    "limits": { "$ref": "#/definitions/limits" }
  },
  "additionalProperties": false,
  "definitions": {
    "limits": {
      "type": "object",
      "properties": {
        "maxOutputTokens": { "type": "integer", "minimum": 0 },
        "maxInputTokens": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
