<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../../scripts/dotnet/Ext.Package.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ext.Clipboard.Windows</AssemblyName>
    <RootNamespace>Webong.Ext.System.Windows</RootNamespace>
    <PackageId>Ext.Clipboard.Windows</PackageId>
    <Description>Generation-checked Win32 clipboard access with an explicit format, item and byte policy, the .NET binding of the Ext capture/clipboard contract.</Description>
    <PackageTags>ext;windows;clipboard</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ext.Clipboard.Windows.Tests" />
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
