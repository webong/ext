    {"name": "thirty-three-representations", "maxBytes": 100, "formats": ["f0", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "f13", "f14", "f15", "f16", "f17", "f18", "f19", "f20", "f21", "f22", "f23", "f24", "f25", "f26", "f27", "f28", "f29", "f30", "f31", "f32"], "items": [{"representations": [{"format": "f0", "text": "a"}, {"format": "f1", "text": "a"}, {"format": "f2", "text": "a"}, {"format": "f3", "text": "a"}, {"format": "f4", "text": "a"}, {"format": "f5", "text": "a"}, {"format": "f6", "text": "a"}, {"format": "f7", "text": "a"}, {"format": "f8", "text": "a"}, {"format": "f9", "text": "a"}, {"format": "f10", "text": "a"}, {"format": "f11", "text": "a"}, {"format": "f12", "text": "a"}, {"format": "f13", "text": "a"}, {"format": "f14", "text": "a"}, {"format": "f15", "text": "a"}, {"format": "f16", "text": "a"}, {"format": "f17", "text": "a"}, {"format": "f18", "text": "a"}, {"format": "f19", "text": "a"}, {"format": "f20", "text": "a"}, {"format": "f21", "text": "a"}, {"format": "f22", "text": "a"}, {"format": "f23", "text": "a"}, {"format": "f24", "text": "a"}, {"format": "f25", "text": "a"}, {"format": "f26", "text": "a"}, {"format": "f27", "text": "a"}, {"format": "f28", "text": "a"}, {"format": "f29", "text": "a"}, {"format": "f30", "text": "a"}, {"format": "f31", "text": "a"}, {"format": "f32", "text": "a"}]}], "code": "invalid"},
    {"name": "ceiling-of-zero", "maxBytes": 0, "formats": ["text/plain", "text/html"], "items": [], "code": "invalid"},
    {"name": "negative-ceiling", "maxBytes": -1, "formats": ["text/plain", "text/html"], "items": [], "code": "invalid"},
    {"name": "ceiling-above-the-policy-maximum", "maxBytes": 16777217, "formats": ["text/plain", "text/html"], "items": [], "code": "invalid"},
    {"name": "a-bad-ceiling-is-judged-before-the-item-count", "maxBytes": 0, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "a"}], "times": 65}], "code": "invalid"},
    {"name": "the-item-count-is-judged-before-formats", "maxBytes": 100, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "image/png", "text": "a"}], "times": 65}], "code": "too_large"},
