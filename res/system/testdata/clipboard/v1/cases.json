{
  "version": 1,
  "area": "clipboard",
  "about": "Pure validation shared by the clipboard bindings. A policy case calls the policy validator; an items case calls the item validator with the given byte ceiling and allowed formats. A case's code is null when the input is accepted. A representation is text (its UTF-8 bytes) or zeros (that many zero bytes); an item with times is repeated. Case order within a list means nothing.",
  "limits": {
    "maxPolicyBytes": 16777216,
    "maxItems": 64,
    "maxFormats": 32,
    "maxFormatBytes": 256
  },
  "policy": [
    {"name": "one-format-and-one-byte", "maxBytes": 1, "formats": ["text/plain"], "code": null},
    {"name": "byte-ceiling-exactly", "maxBytes": 16777216, "formats": ["text/plain"], "code": null},
    {"name": "thirty-two-formats", "maxBytes": 1024, "formats": ["f0", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "f13", "f14", "f15", "f16", "f17", "f18", "f19", "f20", "f21", "f22", "f23", "f24", "f25", "f26", "f27", "f28", "f29", "f30", "f31"], "code": null},
    {"name": "format-name-of-256-bytes", "maxBytes": 1024, "formats": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "code": null},
    {"name": "format-name-of-256-bytes-in-128-characters", "maxBytes": 1024, "formats": ["éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"], "code": null},
    {"name": "format-names-are-case-sensitive", "maxBytes": 1024, "formats": ["text/plain", "TEXT/PLAIN"], "code": null},
    {"name": "zero-bytes", "maxBytes": 0, "formats": ["text/plain"], "code": "invalid"},
    {"name": "negative-bytes", "maxBytes": -1, "formats": ["text/plain"], "code": "invalid"},
    {"name": "bytes-above-the-ceiling", "maxBytes": 16777217, "formats": ["text/plain"], "code": "invalid"},
    {"name": "no-formats", "maxBytes": 1024, "formats": [], "code": "invalid"},
    {"name": "thirty-three-formats", "maxBytes": 1024, "formats": ["f0", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "f13", "f14", "f15", "f16", "f17", "f18", "f19", "f20", "f21", "f22", "f23", "f24", "f25", "f26", "f27", "f28", "f29", "f30", "f31", "f32"], "code": "invalid"},
    {"name": "empty-format-name", "maxBytes": 1024, "formats": ["text/plain", ""], "code": "invalid"},
    {"name": "repeated-format", "maxBytes": 1024, "formats": ["text/plain", "text/html", "text/plain"], "code": "invalid"},
    {"name": "format-name-of-257-bytes", "maxBytes": 1024, "formats": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "code": "invalid"},
    {"name": "format-name-of-258-bytes-in-129-characters", "maxBytes": 1024, "formats": ["ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"], "code": "invalid"}
  ],
  "items": [
    {"name": "no-items-is-a-clear", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [], "code": null},
    {"name": "one-representation-of-exactly-the-ceiling", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "hello"}]}], "code": null},
    {"name": "empty-data", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": ""}]}], "code": null},
