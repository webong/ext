    {"name": "sixteen-mebibytes-of-data", "maxBytes": 16777216, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "zeros": 16777216}]}], "code": null},
    {"name": "one-byte-over-the-ceiling", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "hello!"}]}], "code": "too_large"},
    {"name": "bytes-are-counted-across-representations", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "abc"}, {"format": "text/html", "text": "def"}]}], "code": "too_large"},
    {"name": "bytes-are-counted-across-items", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "abc"}]}, {"representations": [{"format": "text/plain", "text": "def"}]}], "code": "too_large"},
    {"name": "sixty-five-items", "maxBytes": 100, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "a"}], "times": 65}], "code": "too_large"},
    {"name": "sixteen-mebibytes-and-one-byte", "maxBytes": 16777216, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "zeros": 16777217}]}], "code": "too_large"},
    {"name": "format-not-allowed", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "image/png", "text": "a"}]}], "code": "denied"},
    {"name": "format-names-are-case-sensitive", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "TEXT/PLAIN", "text": "a"}]}], "code": "denied"},
    {"name": "format-repeated-in-one-item", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": [{"format": "text/plain", "text": "a"}, {"format": "text/plain", "text": "b"}]}], "code": "denied"},
