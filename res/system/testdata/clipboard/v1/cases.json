    {"name": "the-first-bad-item-decides-no-representations", "maxBytes": 5, "formats": ["text/plain", "text/html"], "items": [{"representations": []}, {"representations": [{"format": "image/png", "text": "a"}]}], "code": "invalid"}
  ]
}
