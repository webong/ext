    {"name": "maxAddresses-above-the-ceiling", "maxInterfaces": 256, "maxAddresses": 65537, "maxRoutes": 4096, "code": "invalid"},
    {"name": "maxAddresses-negative", "maxInterfaces": 256, "maxAddresses": -1, "maxRoutes": 4096, "code": "invalid"},
    {"name": "maxRoutes-above-the-ceiling", "maxInterfaces": 256, "maxAddresses": 256, "maxRoutes": 65537, "code": "invalid"},
    {"name": "maxRoutes-negative", "maxInterfaces": 256, "maxAddresses": 256, "maxRoutes": -1, "code": "invalid"}
