    {"name": "other-schemes", "items": [{"urls": ["mailto:a@example.com", "myapp://open?x=1", "data:text/plain,hi", "tel:+15550100"]}], "code": null, "payload": {"subject": "", "text": "", "urls": ["mailto:a@example.com", "myapp://open?x=1", "data:text/plain,hi", "tel:+15550100"], "attachments": [], "byteCount": 0}},
