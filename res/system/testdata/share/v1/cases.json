{
  "version": 1,
  "area": "share",
  "about": "The share contract: limits and the normalisation of share items into one payload. A limits case builds limits from all four values and reports invalid or accepts them; Go cannot tell an absent limit from zero, so explicit zero is not a case. A normalize case runs the items under its limits (any limit left out is the default) and expects the payload or a code. Strings are compared as written; a missing subject or text is the empty string in the payload. An attachment's text or zeros are its data (UTF-8 bytes, or that many zero bytes); path gives a caller-owned absolute path instead. The trim rule everywhere is: strip leading and trailing U+0009 to U+000D and U+0020 (ASCII white space and the vertical controls); every other control character is content, so a link or a name holding one is invalid.",
  "defaults": {
    "maxItems": 32,
    "maxBytes": 16777216,
    "maxTextBytes": 65536,
    "maxUrlLength": 8192
  },
  "ceilings": {
    "maxItems": 128,
    "maxBytes": 67108864,
    "maxTextBytes": 1048576,
    "maxUrlLength": 8192
  },
  "limits": [
    {"name": "the-smallest-limits", "limits": {"maxItems": 1, "maxBytes": 1, "maxTextBytes": 1, "maxUrlLength": 1}, "code": null},
    {"name": "the-ceilings", "limits": {"maxItems": 128, "maxBytes": 67108864, "maxTextBytes": 1048576, "maxUrlLength": 8192}, "code": null},
    {"name": "the-defaults-are-valid", "limits": {"maxItems": 32, "maxBytes": 16777216, "maxTextBytes": 65536, "maxUrlLength": 8192}, "code": null},
    {"name": "maxItems-above-the-ceiling", "limits": {"maxItems": 129, "maxBytes": 16777216, "maxTextBytes": 65536, "maxUrlLength": 8192}, "code": "invalid"},
    {"name": "maxItems-negative", "limits": {"maxItems": -1, "maxBytes": 16777216, "maxTextBytes": 65536, "maxUrlLength": 8192}, "code": "invalid"},
    {"name": "maxBytes-above-the-ceiling", "limits": {"maxItems": 32, "maxBytes": 67108865, "maxTextBytes": 65536, "maxUrlLength": 8192}, "code": "invalid"},
    {"name": "maxBytes-negative", "limits": {"maxItems": 32, "maxBytes": -1, "maxTextBytes": 65536, "maxUrlLength": 8192}, "code": "invalid"},
    {"name": "maxTextBytes-above-the-ceiling", "limits": {"maxItems": 32, "maxBytes": 16777216, "maxTextBytes": 1048577, "maxUrlLength": 8192}, "code": "invalid"},
    {"name": "maxTextBytes-negative", "limits": {"maxItems": 32, "maxBytes": 16777216, "maxTextBytes": -1, "maxUrlLength": 8192}, "code": "invalid"},
    {"name": "maxUrlLength-above-the-ceiling", "limits": {"maxItems": 32, "maxBytes": 16777216, "maxTextBytes": 65536, "maxUrlLength": 8193}, "code": "invalid"},
    {"name": "maxUrlLength-negative", "limits": {"maxItems": 32, "maxBytes": 16777216, "maxTextBytes": 65536, "maxUrlLength": -1}, "code": "invalid"}
  ],
  "normalize": [
    {"name": "nothing", "items": [], "code": null, "payload": {"subject": "", "text": "", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "one-of-everything", "items": [{"subject": "Title", "text": "Body", "urls": ["https://example.com/a"], "attachments": [{"name": "a.txt", "mimeType": "text/plain", "text": "hello"}]}], "code": null, "payload": {"subject": "Title", "text": "Body", "urls": ["https://example.com/a"], "attachments": [{"name": "a.txt", "mimeType": "text/plain", "size": 5, "text": "hello"}], "byteCount": 5}},
    {"name": "texts-merge-in-order-with-newlines", "items": [{"text": "a"}, {"text": "b"}], "code": null, "payload": {"subject": "", "text": "a\nb", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "subjects-merge-too", "items": [{"subject": "x"}, {"subject": "y"}], "code": null, "payload": {"subject": "x\ny", "text": "", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "exact-duplicate-texts-collapse", "items": [{"text": "a"}, {"text": "a"}, {"text": "b"}], "code": null, "payload": {"subject": "", "text": "a\nb", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "texts-differing-by-case-are-kept", "items": [{"text": "a"}, {"text": "A"}], "code": null, "payload": {"subject": "", "text": "a\nA", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "empty-text-is-ignored", "items": [{"text": ""}, {"text": "a"}], "code": null, "payload": {"subject": "", "text": "a", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "text-is-not-trimmed", "items": [{"text": " a "}], "code": null, "payload": {"subject": "", "text": " a ", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "text-with-nul", "items": [{"text": "a\u0000b"}], "code": "invalid"},
    {"name": "subject-with-nul", "items": [{"subject": "a\u0000b"}], "code": "invalid"},
    {"name": "text-of-exactly-the-bound", "limits": {"maxTextBytes": 5}, "items": [{"text": "hello"}], "code": null, "payload": {"subject": "", "text": "hello", "urls": [], "attachments": [], "byteCount": 0}},
    {"name": "text-over-the-bound", "limits": {"maxTextBytes": 5}, "items": [{"text": "hello!"}], "code": "too_large"},
