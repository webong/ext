      "name": "__Host- with non-root path",
      "cookie": {
        "name": "__Host-id",
        "value": "v",
        "domain": "example.com",
        "path": "/a",
        "expiry": 0,
        "secure": true,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "__Host- valid",
      "cookie": {
        "name": "__Host-id",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": true,
        "http_only": false
      },
      "valid": true
    },
    {
      "name": "SameSite none without secure",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
