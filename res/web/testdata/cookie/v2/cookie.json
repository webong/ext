{
  "doc": "ValidateCookie: portable field rules. Error text never contains the cookie value.",
  "cases": [
    {
      "name": "minimal session cookie",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": true
    },
    {
      "name": "dot domain",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": ".example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": true
    },
    {
      "name": "max expiry",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 253402300799,
        "secure": false,
        "http_only": false
      },
      "valid": true
    },
    {
      "name": "name with space",
      "cookie": {
        "name": "a b",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "empty name",
      "cookie": {
        "name": "",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "name with separator",
      "cookie": {
        "name": "a;b",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "name with control character",
      "cookie": {
        "name": "a\u0001",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "empty domain",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "domain with slash",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "a/b.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "domain with port-like colon",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "example.com:80",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "IPv6 domain",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "::1",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": true
    },
    {
      "name": "domain with two leading dots",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "..example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "path without slash",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "example.com",
        "path": "a",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "value with control character",
      "cookie": {
        "name": "sid",
        "value": "a\nb",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
    },
    {
      "name": "__Secure- without secure",
      "cookie": {
        "name": "__Secure-id",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false
      },
      "valid": false
