        "name": "sid",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false,
        "partition_key": "https://top.example",
        "has_cross_site_ancestor": true
      },
      "valid": true
    },
    {
      "name": "namespaced attribute",
      "cookie": {
        "name": "sid",
        "value": "v",
        "domain": "example.com",
        "path": "/",
        "expiry": 0,
        "secure": false,
        "http_only": false,
