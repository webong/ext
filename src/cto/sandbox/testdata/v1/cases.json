     "classes": ["filesystem", "network.ports", "process", "devices", "environment", "lifecycle.workspace"], "code": null},
    {"name": "invalid-grant", "grant": {"devices": ["GPU"]}, "code": "invalid"}
  ],

  "capabilities": [
    {"name": "confined-driver", "capabilities": {"boundary": "confined", "driver": "landlock", "classes": {"filesystem": {"enforced": true}, "network.proxy": {"enforced": false, "reason": "permission"}}}, "code": null},
    {"name": "no-classes", "capabilities": {"boundary": "process"}, "code": null},
