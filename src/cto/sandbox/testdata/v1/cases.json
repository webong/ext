    {"name": "enforced-with-reason", "capabilities": {"boundary": "confined", "classes": {"filesystem": {"enforced": true, "reason": "permission"}}}, "code": "invalid"},
    {"name": "missing-without-reason", "capabilities": {"boundary": "confined", "classes": {"filesystem": {"enforced": false}}}, "code": "invalid"},
    {"name": "reason-outside-the-set", "capabilities": {"boundary": "confined", "classes": {"filesystem": {"enforced": false, "reason": "no_device"}}}, "code": "invalid"},
    {"name": "driver-with-space", "capabilities": {"boundary": "confined", "driver": "land lock"}, "code": "invalid"}
