     "outcome": {"enforced": [], "missing": [{"class": "filesystem", "reason": "unsupported"}, {"class": "network.none", "reason": "unsupported"}, {"class": "process", "reason": "unsupported"}, {"class": "devices", "reason": "unsupported"}, {"class": "environment", "reason": "unsupported"}, {"class": "lifecycle.fresh", "reason": "unsupported"}], "unenforced": ["filesystem", "network.none", "process", "devices", "environment", "lifecycle.fresh"]}, "code": null},
