{
  "version": 1,
  "about": "The sandbox contract of docs/adr-sandboxing.md. Every implementation runs every section. A case's code is null when the call succeeds, else the stable code it fails with (codes.json). A grant, outcome or report is compared as data: field order means nothing, list order does. Error text is never part of a case.",
  "limits": {
    "maxPaths": 256,
    "maxPathBytes": 4096,
    "maxPorts": 256,
    "maxHosts": 256,
    "maxHostBytes": 253,
    "maxDevices": 64,
    "maxDeviceBytes": 128,
    "maxEnvNames": 256,
    "maxEnvBytes": 32768,
    "maxNameBytes": 256,
    "maxRefBytes": 1024
  },
  "boundaries": ["in-process", "process", "confined", "runtime", "container", "kernel"],
  "classes": [
    "filesystem", "network.none", "network.ports", "network.proxy", "network.open", "process", "devices", "environment",
    "resources.memoryBytes", "resources.milliCpu", "resources.pids", "resources.cpuTimeMs", "resources.wallTimeMs", "resources.openFiles", "resources.writeBytes",
    "lifecycle.fresh", "lifecycle.workspace", "lifecycle.snapshot.filesystem", "lifecycle.snapshot.memory"
  ],
  "reasons": ["unsupported", "permission", "tool_missing"],

  "accept": [
    {"name": "empty-set-accepts-any", "accepted": [], "boundary": "process", "code": null},
    {"name": "member", "accepted": ["confined", "kernel"], "boundary": "confined", "code": null},
    {"name": "not-a-member", "accepted": ["confined", "kernel"], "boundary": "process", "code": "denied"},
    {"name": "in-process-refused", "accepted": ["runtime", "confined", "kernel"], "boundary": "in-process", "code": "denied"},
    {"name": "unknown-boundary", "accepted": [], "boundary": "vm", "code": "invalid"},
    {"name": "empty-boundary", "accepted": [], "boundary": "", "code": "invalid"},
    {"name": "boundary-is-case-sensitive", "accepted": [], "boundary": "Kernel", "code": "invalid"},
    {"name": "unknown-member", "accepted": ["vm"], "boundary": "kernel", "code": "invalid"}
  ],

  "validate": [
    {"name": "empty", "policy": {}, "code": null},
    {"name": "everything", "policy": {
      "filesystem": [{"path": "/work", "access": ["read", "write"]}, {"path": "/usr", "access": ["read", "execute"]}],
      "network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]},
      "process": {"children": true},
      "devices": ["gpu/0"],
      "resources": {"memoryBytes": 1073741824, "milliCpu": 500, "pids": 64, "cpuTimeMs": 1000, "wallTimeMs": 60000, "openFiles": 256, "writeBytes": 1048576},
      "environment": {"names": ["HOME"], "entries": ["LANG=C"], "secrets": [{"name": "TOKEN", "ref": "keychain:token"}]},
      "lifecycle": {"mode": "snapshot", "name": "base-1.2", "restore": "memory"}
    }, "code": null},
    {"name": "root-path", "policy": {"filesystem": [{"path": "/", "access": ["read"]}]}, "code": null},
    {"name": "drive-path", "policy": {"filesystem": [{"path": "C:/Users/me", "access": ["read"]}]}, "code": null},
    {"name": "drive-root", "policy": {"filesystem": [{"path": "C:/", "access": ["read"]}]}, "code": null},
    {"name": "relative-path", "policy": {"filesystem": [{"path": "work", "access": ["read"]}]}, "code": "invalid"},
    {"name": "empty-path", "policy": {"filesystem": [{"path": "", "access": ["read"]}]}, "code": "invalid"},
    {"name": "dot-dot", "policy": {"filesystem": [{"path": "/a/../b", "access": ["read"]}]}, "code": "invalid"},
    {"name": "dot", "policy": {"filesystem": [{"path": "/a/./b", "access": ["read"]}]}, "code": "invalid"},
    {"name": "double-slash", "policy": {"filesystem": [{"path": "/a//b", "access": ["read"]}]}, "code": "invalid"},
    {"name": "trailing-slash", "policy": {"filesystem": [{"path": "/a/", "access": ["read"]}]}, "code": "invalid"},
    {"name": "lowercase-drive", "policy": {"filesystem": [{"path": "c:/x", "access": ["read"]}]}, "code": "invalid"},
    {"name": "backslash", "policy": {"filesystem": [{"path": "C:\\x", "access": ["read"]}]}, "code": "invalid"},
    {"name": "duplicate-path", "policy": {"filesystem": [{"path": "/a", "access": ["read"]}, {"path": "/a", "access": ["write"]}]}, "code": "invalid"},
    {"name": "no-access", "policy": {"filesystem": [{"path": "/a", "access": []}]}, "code": "invalid"},
    {"name": "unknown-access", "policy": {"filesystem": [{"path": "/a", "access": ["list"]}]}, "code": "invalid"},
    {"name": "duplicate-access", "policy": {"filesystem": [{"path": "/a", "access": ["read", "read"]}]}, "code": "invalid"},
    {"name": "access-in-any-order", "policy": {"filesystem": [{"path": "/a", "access": ["execute", "read"]}]}, "code": null},
    {"name": "unknown-network-mode", "policy": {"network": {"mode": "any"}}, "code": "invalid"},
    {"name": "open-network", "policy": {"network": {"mode": "open"}}, "code": null},
    {"name": "proxy-with-no-hosts", "policy": {"network": {"mode": "proxy"}}, "code": null},
    {"name": "ports-under-none", "policy": {"network": {"mode": "none", "ports": [443]}}, "code": "invalid"},
    {"name": "ports-under-default", "policy": {"network": {"ports": [443]}}, "code": "invalid"},
    {"name": "hosts-under-ports", "policy": {"network": {"mode": "ports", "hosts": [{"host": "a.com", "port": 443}]}}, "code": "invalid"},
    {"name": "port-zero", "policy": {"network": {"mode": "ports", "ports": [0]}}, "code": "invalid"},
    {"name": "port-too-high", "policy": {"network": {"mode": "ports", "ports": [65536]}}, "code": "invalid"},
    {"name": "duplicate-port", "policy": {"network": {"mode": "ports", "ports": [443, 443]}}, "code": "invalid"},
    {"name": "uppercase-host", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "API.github.com", "port": 443}]}}, "code": "invalid"},
    {"name": "host-leading-hyphen", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "-a.com", "port": 443}]}}, "code": "invalid"},
    {"name": "host-empty-label", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "a..com", "port": 443}]}}, "code": "invalid"},
    {"name": "host-wildcard", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "*.github.com", "port": 443}]}}, "code": "invalid"},
    {"name": "host-without-port", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "a.com"}]}}, "code": "invalid"},
    {"name": "address-host", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "10.0.0.1", "port": 8080}]}}, "code": null},
    {"name": "duplicate-host", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}, {"host": "a.com", "port": 443}]}}, "code": "invalid"},
    {"name": "same-host-two-ports", "policy": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 80}, {"host": "a.com", "port": 443}]}}, "code": null},
    {"name": "uppercase-device", "policy": {"devices": ["GPU"]}, "code": "invalid"},
    {"name": "duplicate-device", "policy": {"devices": ["gpu/0", "gpu/0"]}, "code": "invalid"},
    {"name": "zero-bound", "policy": {"resources": {"memoryBytes": 0}}, "code": "invalid"},
    {"name": "negative-bound", "policy": {"resources": {"pids": -1}}, "code": "invalid"},
    {"name": "smallest-bound", "policy": {"resources": {"wallTimeMs": 1}}, "code": null},
    {"name": "env-name-starts-with-digit", "policy": {"environment": {"names": ["1A"]}}, "code": "invalid"},
    {"name": "env-entry-without-equals", "policy": {"environment": {"entries": ["A"]}}, "code": "invalid"},
    {"name": "env-entry-empty-value", "policy": {"environment": {"entries": ["A="]}}, "code": null},
    {"name": "env-entry-and-secret-same-name", "policy": {"environment": {"entries": ["A=1"], "secrets": [{"name": "A", "ref": "r"}]}}, "code": "invalid"},
    {"name": "secret-without-ref", "policy": {"environment": {"secrets": [{"name": "A", "ref": ""}]}}, "code": "invalid"},
    {"name": "duplicate-env-name", "policy": {"environment": {"names": ["A", "A"]}}, "code": "invalid"},
    {"name": "unknown-lifecycle", "policy": {"lifecycle": {"mode": "temp"}}, "code": "invalid"},
    {"name": "fresh-with-name", "policy": {"lifecycle": {"mode": "fresh", "name": "a"}}, "code": "invalid"},
    {"name": "workspace-without-name", "policy": {"lifecycle": {"mode": "workspace"}}, "code": null},
    {"name": "workspace-name-with-slash", "policy": {"lifecycle": {"mode": "workspace", "name": "a/b"}}, "code": "invalid"},
    {"name": "workspace-with-restore", "policy": {"lifecycle": {"mode": "workspace", "name": "a", "restore": "filesystem"}}, "code": "invalid"},
    {"name": "snapshot-without-restore", "policy": {"lifecycle": {"mode": "snapshot", "name": "a"}}, "code": "invalid"},
    {"name": "snapshot-unknown-restore", "policy": {"lifecycle": {"mode": "snapshot", "name": "a", "restore": "disk"}}, "code": "invalid"},
    {"name": "snapshot-filesystem", "policy": {"lifecycle": {"mode": "snapshot", "name": "a", "restore": "filesystem"}}, "code": null}
  ],

  "grant": [
    {"name": "empty-request-gets-only-policy-bounds",
     "request": {},
     "policy": {"filesystem": [{"path": "/work", "access": ["read", "write"]}], "network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]}, "process": {"children": true}, "devices": ["gpu/0"], "resources": {"memoryBytes": 1073741824}, "environment": {"entries": ["LANG=C"]}},
     "grant": {"network": {"mode": "none"}, "resources": {"memoryBytes": 1073741824}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "policy-as-its-own-request",
     "request": {"filesystem": [{"path": "/work", "access": ["read", "write"]}], "network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]}, "process": {"children": true}, "devices": ["gpu/0"], "resources": {"pids": 64}, "environment": {"entries": ["LANG=C"], "secrets": [{"name": "TOKEN", "ref": "keychain:token"}]}, "lifecycle": {"mode": "workspace", "name": "w1"}},
     "policy": {"filesystem": [{"path": "/work", "access": ["read", "write"]}], "network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]}, "process": {"children": true}, "devices": ["gpu/0"], "resources": {"pids": 64}, "environment": {"entries": ["LANG=C"], "secrets": [{"name": "TOKEN", "ref": "keychain:token"}]}, "lifecycle": {"mode": "workspace", "name": "w1"}},
     "grant": {"filesystem": [{"path": "/work", "access": ["read", "write"]}], "network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]}, "process": {"children": true}, "devices": ["gpu/0"], "resources": {"pids": 64}, "environment": {"entries": ["LANG=C"], "secrets": [{"name": "TOKEN", "ref": "keychain:token"}]}, "lifecycle": {"mode": "workspace", "name": "w1"}},
     "refused": [], "code": null},
    {"name": "paths-below-a-policy-path",
     "request": {"filesystem": [{"path": "/work/src", "access": ["read"]}, {"path": "/work/out", "access": ["execute", "write"]}, {"path": "/etc", "access": ["read"]}]},
     "policy": {"filesystem": [{"path": "/work", "access": ["read", "write"]}]},
     "grant": {"filesystem": [{"path": "/work/src", "access": ["read"]}, {"path": "/work/out", "access": ["write"]}], "network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "filesystem", "path": "/work/out", "access": ["execute"]}, {"class": "filesystem", "path": "/etc", "access": ["read"]}], "code": null},
    {"name": "root-covers-everything",
     "request": {"filesystem": [{"path": "/usr/lib", "access": ["read"]}]},
     "policy": {"filesystem": [{"path": "/", "access": ["read"]}]},
     "grant": {"filesystem": [{"path": "/usr/lib", "access": ["read"]}], "network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "sibling-with-same-prefix-is-not-below",
     "request": {"filesystem": [{"path": "/workspace", "access": ["read"]}]},
     "policy": {"filesystem": [{"path": "/work", "access": ["read"]}]},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "filesystem", "path": "/workspace", "access": ["read"]}], "code": null},
    {"name": "drive-root-covers-its-drive-only",
     "request": {"filesystem": [{"path": "C:/Users", "access": ["read"]}, {"path": "D:/data", "access": ["read"]}]},
     "policy": {"filesystem": [{"path": "C:/", "access": ["read"]}]},
     "grant": {"filesystem": [{"path": "C:/Users", "access": ["read"]}], "network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "filesystem", "path": "D:/data", "access": ["read"]}], "code": null},
    {"name": "covering-paths-combine",
     "request": {"filesystem": [{"path": "/a/b/c", "access": ["write", "read"]}]},
     "policy": {"filesystem": [{"path": "/a", "access": ["read"]}, {"path": "/a/b", "access": ["write"]}]},
     "grant": {"filesystem": [{"path": "/a/b/c", "access": ["read", "write"]}], "network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "proxy-hosts-intersect",
     "request": {"network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}, {"host": "evil.example", "port": 443}]}},
     "policy": {"network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}, {"host": "pypi.org", "port": 443}]}},
     "grant": {"network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "network", "host": {"host": "evil.example", "port": 443}}], "code": null},
    {"name": "proxy-host-port-must-match",
     "request": {"network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 80}]}},
     "policy": {"network": {"mode": "proxy", "hosts": [{"host": "api.github.com", "port": 443}]}},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "network", "host": {"host": "api.github.com", "port": 80}}], "code": null},
    {"name": "network-mode-mismatch",
     "request": {"network": {"mode": "ports", "ports": [443]}},
     "policy": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}]}},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "network"}], "code": null},
    {"name": "network-refused-by-default",
     "request": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}]}},
     "policy": {},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "network"}], "code": null},
    {"name": "open-policy-grants-the-request",
     "request": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}]}},
     "policy": {"network": {"mode": "open"}},
     "grant": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}]}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "open-request-needs-open-policy",
     "request": {"network": {"mode": "open"}},
     "policy": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}]}},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "network"}], "code": null},
    {"name": "open-granted",
     "request": {"network": {"mode": "open"}},
     "policy": {"network": {"mode": "open"}},
     "grant": {"network": {"mode": "open"}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "ports-intersect",
     "request": {"network": {"mode": "ports", "ports": [80, 443]}},
     "policy": {"network": {"mode": "ports", "ports": [443, 8443]}},
     "grant": {"network": {"mode": "ports", "ports": [443]}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "network", "port": 80}], "code": null},
    {"name": "children-refused",
     "request": {"process": {"children": true}},
     "policy": {},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "process"}], "code": null},
    {"name": "devices-intersect",
     "request": {"devices": ["gpu/0", "camera"]},
     "policy": {"devices": ["gpu/0"]},
     "grant": {"network": {"mode": "none"}, "devices": ["gpu/0"], "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "devices", "name": "camera"}], "code": null},
    {"name": "resources-take-the-lower-bound",
     "request": {"resources": {"memoryBytes": 536870912, "wallTimeMs": 120000}},
     "policy": {"resources": {"memoryBytes": 1073741824, "wallTimeMs": 60000, "pids": 64}},
     "grant": {"network": {"mode": "none"}, "resources": {"memoryBytes": 536870912, "wallTimeMs": 60000, "pids": 64}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "resources.wallTimeMs"}], "code": null},
    {"name": "requested-bound-without-policy-bound",
     "request": {"resources": {"cpuTimeMs": 1000}},
     "policy": {},
     "grant": {"network": {"mode": "none"}, "resources": {"cpuTimeMs": 1000}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "environment-by-name",
     "request": {"environment": {"names": ["LANG", "TOKEN", "HOME"]}},
     "policy": {"environment": {"entries": ["LANG=C", "TZ=UTC"], "secrets": [{"name": "TOKEN", "ref": "keychain:token"}]}},
     "grant": {"network": {"mode": "none"}, "environment": {"entries": ["LANG=C"], "secrets": [{"name": "TOKEN", "ref": "keychain:token"}]}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "environment", "name": "HOME"}], "code": null},
    {"name": "requested-value-is-never-granted",
     "request": {"environment": {"entries": ["LANG=fr_FR"]}},
     "policy": {"environment": {"entries": ["LANG=C"]}},
     "grant": {"network": {"mode": "none"}, "environment": {"entries": ["LANG=C"]}, "lifecycle": {"mode": "fresh"}},
     "refused": [], "code": null},
    {"name": "lifecycle-mode-mismatch",
     "request": {"lifecycle": {"mode": "workspace"}},
     "policy": {},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "fresh"}},
     "refused": [{"class": "lifecycle"}], "code": null},
    {"name": "snapshot-scope-mismatch",
     "request": {"lifecycle": {"mode": "snapshot", "restore": "memory"}},
     "policy": {"lifecycle": {"mode": "snapshot", "name": "base", "restore": "filesystem"}},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "snapshot", "name": "base", "restore": "filesystem"}},
     "refused": [{"class": "lifecycle"}], "code": null},
    {"name": "policy-names-the-workspace",
     "request": {"lifecycle": {"mode": "workspace", "name": "guest-choice"}},
     "policy": {"lifecycle": {"mode": "workspace", "name": "host-choice"}},
     "grant": {"network": {"mode": "none"}, "lifecycle": {"mode": "workspace", "name": "host-choice"}},
     "refused": [], "code": null},
    {"name": "policy-workspace-without-name",
     "request": {},
     "policy": {"lifecycle": {"mode": "workspace"}},
     "code": "invalid"},
    {"name": "invalid-request",
     "request": {"filesystem": [{"path": "relative", "access": ["read"]}]},
     "policy": {},
     "code": "invalid"},
    {"name": "invalid-policy",
     "request": {},
     "policy": {"network": {"mode": "anything"}},
     "code": "invalid"}
  ],

  "required": [
    {"name": "empty-grant", "grant": {}, "classes": ["filesystem", "network.none", "process", "devices", "environment", "lifecycle.fresh"], "code": null},
    {"name": "proxy-bounds-snapshot",
     "grant": {"network": {"mode": "proxy", "hosts": [{"host": "a.com", "port": 443}]}, "resources": {"pids": 8, "memoryBytes": 1024}, "lifecycle": {"mode": "snapshot", "name": "base", "restore": "memory"}},
     "classes": ["filesystem", "network.proxy", "process", "devices", "environment", "resources.memoryBytes", "resources.pids", "lifecycle.snapshot.memory"], "code": null},
    {"name": "workspace-and-ports",
