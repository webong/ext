#!/usr/bin/env sh
set -eu

if [ "${1:-}" = --version ]; then
  printf 'container CLI version %s\n' "${EXT_TEST_APPLE_VERSION:-1.4.0}"
  exit 0
fi

if [ "${1:-}" = system ] && [ "${2:-}" = version ]; then
  printf 'container 1.4.0\n'
  exit 0
fi

if [ "${1:-}" = volume ] && [ "${2:-}" = inspect ]; then
  [ "${3:-}" = exists ] && exit 0
  exit 1
fi

printf '%s\n' "$*"
